--- /dev/null
+++ b/core/src/player/portable_snapshot.rs
@@ -0,0 +1,305 @@
+//! Checkpoints for a statically verified, sealed offline AVM1 subset.
+//!
+//! This is deliberately not a save-any-SWF API. The private Player cannot be
+//! mutated by callers. Validation excludes state that this format cannot save.
+use super::{LoadBehavior, Player, PlayerBuilder};
+use crate::avm_rng::AvmRng;
+use crate::avm1::{Attribute, HeapSnapshot, Value};
+use crate::backend::log::LogBackend;
+use crate::display_object::{TDisplayObject, portable_snapshot as display};
+use crate::frame_lifecycle::FramePhase;
+use crate::limits::ExecutionLimit;
+use crate::string::AvmString;
+use crate::tag_utils::SwfMovieData;
+use serde::{Deserialize, Serialize};
+use std::num::NonZeroU32;
+use std::sync::{Arc, Mutex};
+mod policy;
+#[cfg(test)]
+mod render_probe;
+#[cfg(test)]
+mod tests;
+
+const FORMAT: &str = "ruffle-045db00b-sealed-avm1-v1";
+const MAX_SAVE: usize = 8 * 1024 * 1024;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Checkpoint {
+    format: String,
+    // Exact immutable SWF identity, embedded rather than relying on a URL/hash.
+    movie: Vec<u8>,
+    heap: HeapSnapshot,
+    display: display::DisplayTreeSnapshot,
+    rng: u32,
+    completed_steps: u64,
+    background: Option<[u8; 4]>,
+    arrow_keys: [bool; 2],
+    builtin_pool: Vec<Vec<u16>>,
+}
+
+#[derive(Clone, Default)]
+struct TraceLog(Arc<Mutex<Vec<String>>>);
+impl LogBackend for TraceLog {
+    fn avm_trace(&self, message: &str) {
+        self.0.lock().unwrap().push(message.into());
+    }
+    fn avm_warning(&self, message: &str) {
+        self.0.lock().unwrap().push(format!("WARNING: {message}"));
+    }
+}
+
+/// Offline actual Ruffle Player with a deliberately closed feature policy.
+///
+/// `step` is the only execution API. Controller input is numeric root state
+/// (names beginning `s_`); no host clock, callbacks, or live resources exist.
+/// Restoring creates a fresh arena and rebinds static assets/native prototypes;
+/// it does not execute earlier frame scripts.
+pub struct SealedAvm1Player {
+    player: Arc<Mutex<Player>>,
+    movie: Vec<u8>,
+    trace: TraceLog,
+    completed_steps: u64,
+    arrow_keys: [bool; 2],
+    builtin_pool: Vec<Vec<u16>>,
+    #[cfg(test)]
+    recorder: render_probe::RecordingRenderer,
+    manifest: policy::Manifest,
+}
+
+impl SealedAvm1Player {
+    pub fn new(movie: &[u8], seed: u32) -> Result<Self, String> {
+        let manifest = policy::validate(movie)?;
+        let seed = NonZeroU32::new(seed).ok_or("zero RNG state is not portable")?;
+        let parsed = SwfMovieData::from_data(movie, "file:///sealed/movie.swf".into(), None, None)
+            .map_err(|e| e.to_string())?;
+        let trace = TraceLog::default();
+        let builder = PlayerBuilder::new()
+            .with_movie(parsed)
+            .with_log(trace.clone())
+            .with_load_behavior(LoadBehavior::Blocking);
+        #[cfg(test)]
+        let recorder = render_probe::RecordingRenderer::new();
+        #[cfg(test)]
+        let builder = builder.with_renderer(recorder.clone());
+        let player = builder.build();
+        let builtin_pool = {
+            let mut player = player.lock().map_err(|_| "player lock poisoned")?;
+            player.rng = AvmRng::from_snapshot_state(seed);
+            if !player.preload(&mut ExecutionLimit::none()) {
+                return Err("movie did not preload".into());
+            }
+            Self::constant_pool(&mut player)?
+        };
+        Ok(Self {
+            player,
+            movie: movie.to_vec(),
+            trace,
+            completed_steps: 0,
+            arrow_keys: [false; 2],
+            builtin_pool,
+            manifest,
+            #[cfg(test)]
+            recorder,
+        })
+    }
+
+    /// Deliver real keyboard transitions. The policy allows only Key.isDown for
+    /// these two keys; listeners/getCode/isToggled and other input APIs are rejected.
+    pub fn set_arrow_keys(&mut self, left: bool, right: bool) -> Result<(), String> {
+        use crate::events::{
+            KeyDescriptor, KeyLocation, LogicalKey, NamedKey, PhysicalKey, PlayerEvent,
+        };
+        let wanted = [left, right];
+        let mut player = self.player.lock().map_err(|_| "player lock poisoned")?;
+        for (i, (physical_key, named)) in [
+            (PhysicalKey::ArrowLeft, NamedKey::ArrowLeft),
+            (PhysicalKey::ArrowRight, NamedKey::ArrowRight),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            if wanted[i] != self.arrow_keys[i] {
+                let key = KeyDescriptor {
+                    physical_key,
+                    logical_key: LogicalKey::Named(named),
+                    key_location: KeyLocation::Standard,
+                };
+                player.handle_event(if wanted[i] {
+                    PlayerEvent::KeyDown { key }
+                } else {
+                    PlayerEvent::KeyUp { key }
+                });
+            }
+        }
+        self.arrow_keys = wanted;
+        Ok(())
+    }
+
+    /// Advance one completed Ruffle frame with explicitly supplied controller state.
+    pub fn step(&mut self, input: &[(&str, f64)]) -> Result<(), String> {
+        for (name, value) in input {
+            if !policy::state_name(name) || !value.is_finite() {
+                return Err("invalid controller state".into());
+            }
+        }
+        let mut player = self.player.lock().map_err(|_| "player lock poisoned")?;
+        player.mutate_with_update_context(|context| {
+            let root = context.stage.root_clip().unwrap().object1().unwrap();
+            for (name, value) in input {
+                root.define_value(
+                    context.gc(),
+                    AvmString::new_utf8(context.gc(), *name),
+                    Value::Number(*value),
+                    Attribute::empty(),
+                );
+            }
+        });
+        player.run_frame();
+        Self::check_boundary(&mut player)?;
+        self.completed_steps = self.completed_steps.checked_add(1).ok_or("step overflow")?;
+        Ok(())
+    }
+
+    fn check_boundary(player: &mut Player) -> Result<(), String> {
+        player.mutate_with_update_context(|context| {
+            if !context.action_queue.portable_is_empty()
+                || !context.post_frame_callbacks.is_empty()
+                || !context.avm1.portable_quiescent()
+                || *context.frame_phase != FramePhase::Idle
+            {
+                return Err(format!(
+                    "not quiescent: queue={}, callbacks={}, AVM={}, stack={}, pool={}, phase={:?}",
+                    context.action_queue.portable_is_empty(),
+                    context.post_frame_callbacks.len(),
+                    context.avm1.portable_quiescent(),
+                    context.avm1.stack_len(),
+                    context.avm1.constant_pool().len(),
+                    context.frame_phase
+                ));
+            }
+            Ok(())
+        })
+    }
+
+    fn constant_pool(player: &mut Player) -> Result<Vec<Vec<u16>>, String> {
+        player.mutate_with_update_context(|context| {
+            context
+                .avm1
+                .constant_pool()
+                .iter()
+                .map(|value| match value {
+                    Value::String(value) => Ok(value.iter().collect()),
+                    _ => Err("non-string builtin constant pool".into()),
+                })
+                .collect()
+        })
+    }
+
+    pub fn take_trace(&mut self) -> Vec<String> {
+        std::mem::take(&mut *self.trace.0.lock().unwrap())
+    }
+
+    pub fn checkpoint(&mut self) -> Result<Vec<u8>, String> {
+        if self.completed_steps == 0 {
+            return Err("checkpoint requires a completed frame".into());
+        }
+        let mut player = self.player.lock().map_err(|_| "player lock poisoned")?;
+        Self::check_boundary(&mut player)?;
+        if Self::constant_pool(&mut player)? != self.builtin_pool {
+            return Err("builtin constant pool changed".into());
+        }
+        let (heap, tree, background) = player.mutate_with_update_context(|context| {
+            let root = context
+                .stage
+                .root_clip()
+                .and_then(|root| root.as_movie_clip())
+                .ok_or("missing root")?;
+            let heap = HeapSnapshot::capture_sealed(
+                root.object1().ok_or("missing AVM1 root")?,
+                context.gc(),
+            )
+            .map_err(|e| e.to_string())?;
+            let tree = display::capture(root, context)?;
+            let background = context
+                .stage
+                .background_color()
+                .map(|c| [c.r, c.g, c.b, c.a]);
+            Ok::<_, String>((heap, tree, background))
+        })?;
+        self.manifest.validate_tree(&tree)?;
+        let saved = Checkpoint {
+            format: FORMAT.into(),
+            movie: self.movie.clone(),
+            heap,
+            display: tree,
+            rng: player
+                .rng
+                .snapshot_state()
+                .ok_or("uninitialized RNG")?
+                .get(),
+            completed_steps: self.completed_steps,
+            background,
+            arrow_keys: self.arrow_keys,
+            builtin_pool: self.builtin_pool.clone(),
+        };
+        let bytes = serde_json::to_vec(&saved).map_err(|e| e.to_string())?;
+        if bytes.len() > MAX_SAVE {
+            return Err("checkpoint exceeds size limit".into());
+        }
+        Ok(bytes)
+    }
+
+    pub fn restore(bytes: &[u8]) -> Result<Self, String> {
+        if bytes.len() > MAX_SAVE {
+            return Err("checkpoint exceeds size limit".into());
+        }
+        let saved: Checkpoint = serde_json::from_slice(bytes).map_err(|e| e.to_string())?;
+        if saved.format != FORMAT || saved.completed_steps == 0 {
+            return Err("unsupported checkpoint format/boundary".into());
+        }
+        let mut result = Self::new(&saved.movie, saved.rng)?;
+        if result.builtin_pool != saved.builtin_pool {
+            return Err("builtin constant pool mismatch".into());
+        }
+        result.manifest.validate_tree(&saved.display)?;
+        {
+            let mut player = result.player.lock().map_err(|_| "player lock poisoned")?;
+            player.mutate_with_update_context(|context| {
+                let root = context
+                    .stage
+                    .root_clip()
+                    .and_then(|root| root.as_movie_clip())
+                    .ok_or("missing root")?;
+                display::restore(root, &saved.display, context)?;
+                saved
+                    .heap
+                    .restore_sealed(root.object1().ok_or("missing root object")?, context.gc())
+                    .map_err(|e| e.to_string())?;
+                context
+                    .stage
+                    .set_background_color(saved.background.map(|c| swf::Color {
+                        r: c[0],
+                        g: c[1],
+                        b: c[2],
+                        a: c[3],
+                    }));
+                // post_instantiation queues empty Construct events. Policy forbids
+                // custom constructors/handlers, so draining creates no user code.
+                Player::run_actions(context);
+                // Player-global initialization may leave scratch registers.
+                // Completed AVM1 frames clear them; the sealed policy never stores
+                // registers, and saved boundaries require them to be Undefined.
+                context.avm1.clear();
+                Ok::<_, String>(())
+            })?;
+            Self::check_boundary(&mut player)?;
+        }
+        if !result.trace.0.lock().unwrap().is_empty() {
+            return Err("restore unexpectedly executed trace-producing code".into());
+        }
+        result.completed_steps = saved.completed_steps;
+        result.set_arrow_keys(saved.arrow_keys[0], saved.arrow_keys[1])?;
+        Ok(result)
+    }
+}
diff --git a/core/src/player/portable_snapshot/policy.rs b/core/src/player/portable_snapshot/policy.rs
new file mode 100644
index 00000000..bb9f72d2
--- /dev/null
+++ b/core/src/player/portable_snapshot/policy.rs
@@ -0,0 +1,350 @@
+//! Static capability/operand validation: omitted instructions are rejected.
+use std::collections::{HashMap, HashSet};
+use swf::avm1::types::{Action, Value};
+use swf::{PlaceObjectAction, Tag};
+
+pub(super) fn state_name(name: &str) -> bool {
+    name.len() > 2
+        && name.len() <= 128
+        && name.starts_with("s_")
+        && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+}
+fn instance_name(name: &str) -> bool {
+    name.len() > 5
+        && name.len() <= 128
+        && name.starts_with("clip_")
+        && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+}
+
+#[derive(Clone)]
+struct StaticNode {
+    id: u16,
+    depth: i32,
+    name: Option<Vec<u16>>,
+    children: Vec<StaticNode>,
+}
+pub(super) struct Manifest {
+    children: Vec<StaticNode>,
+}
+impl Manifest {
+    pub fn validate_tree(
+        &self,
+        tree: &crate::display_object::portable_snapshot::DisplayTreeSnapshot,
+    ) -> Result<(), String> {
+        fn compare(
+            expected: &[StaticNode],
+            actual: &[crate::display_object::portable_snapshot::DisplayNodeSnapshot],
+        ) -> bool {
+            expected.len() == actual.len()
+                && expected.iter().zip(actual).all(|(a, b)| {
+                    a.id == b.character_id
+                        && a.depth == b.depth
+                        && a.name == b.name
+                        && b.place_frame == 1
+                        && compare(&a.children, &b.children)
+                })
+        }
+        if compare(&self.children, &tree.root.children) {
+            Ok(())
+        } else {
+            Err("checkpoint display tree differs from immutable SWF placement manifest".into())
+        }
+    }
+}
+
+pub(super) fn validate(bytes: &[u8]) -> Result<Manifest, String> {
+    if bytes.len() < 8
+        || bytes.len() > 1024 * 1024
+        || &bytes[..3] != b"FWS"
+        || bytes[3] != 7
+        || u32::from_le_bytes(bytes[4..8].try_into().unwrap()) as usize != bytes.len()
+    {
+        return Err("policy requires bounded, uncompressed, length-exact SWF 7".into());
+    }
+    let buffer = swf::decompress_swf(bytes).map_err(|e| e.to_string())?;
+    let movie = swf::parse_swf(&buffer).map_err(|e| e.to_string())?;
+    let mut chars = HashMap::new();
+    let mut targets = HashSet::new();
+    validate_tags(
+        &movie.tags,
+        movie.header.num_frames(),
+        true,
+        &mut chars,
+        &mut targets,
+    )?;
+    // All targets are now known; validate actions after declarations.
+    for tag in &movie.tags {
+        if let Tag::DoAction(bytes) = tag {
+            validate_actions(bytes, &targets)?;
+        }
+    }
+    let mut assets = HashMap::new();
+    fn placements(tags: &[Tag<'_>], assets: &HashMap<u16, Vec<StaticNode>>) -> Vec<StaticNode> {
+        let mut nodes: Vec<_> = tags
+            .iter()
+            .filter_map(|tag| {
+                if let Tag::PlaceObject(place) = tag {
+                    let PlaceObjectAction::Place(id) = place.action else {
+                        unreachable!()
+                    };
+                    Some(StaticNode {
+                        id,
+                        depth: i32::from(place.depth),
+                        name: place
+                            .name
+                            .map(|n| n.as_bytes().iter().map(|b| u16::from(*b)).collect()),
+                        children: assets.get(&id).cloned().unwrap_or_default(),
+                    })
+                } else {
+                    None
+                }
+            })
+            .collect();
+        nodes.sort_by_key(|node| node.depth);
+        nodes
+    }
+    for tag in &movie.tags {
+        if let Tag::DefineSprite(sprite) = tag {
+            assets.insert(sprite.id, placements(&sprite.tags, &assets));
+        }
+    }
+    Ok(Manifest {
+        children: placements(&movie.tags, &assets),
+    })
+}
+
+fn validate_tags(
+    tags: &[Tag<'_>],
+    expected_frames: u16,
+    root: bool,
+    chars: &mut HashMap<u16, bool>,
+    targets: &mut HashSet<String>,
+) -> Result<(), String> {
+    let mut frames = 0u16;
+    let mut depths = HashSet::new();
+    let mut names = HashSet::new();
+    for tag in tags {
+        match tag {
+            Tag::End => (),
+            Tag::ShowFrame => {
+                frames = frames.checked_add(1).ok_or("too many frames")?;
+            }
+            Tag::DoAction(_) if root => (),
+            Tag::SetBackgroundColor(_) if root && frames == 0 => (),
+            Tag::DefineShape(shape) if root && frames == 0 => {
+                if shape.version > 3
+                    || shape.id == 0
+                    || chars.insert(shape.id, false).is_some()
+                    || !shape.styles.line_styles.is_empty()
+                    || shape
+                        .styles
+                        .fill_styles
+                        .iter()
+                        .any(|s| !matches!(s, swf::FillStyle::Color(_)))
+                    || shape.shape.iter().any(
+                        |s| matches!(s, swf::ShapeRecord::StyleChange(c) if c.new_styles.is_some()),
+                    )
+                {
+                    return Err("unsupported shape definition".into());
+                }
+            }
+            Tag::DefineSprite(sprite) if root && frames == 0 => {
+                if sprite.id == 0 || sprite.num_frames != 1 || chars.contains_key(&sprite.id) {
+                    return Err("unsupported sprite definition".into());
+                }
+                validate_tags(&sprite.tags, 1, false, chars, targets)?;
+                chars.insert(sprite.id, true);
+            }
+            Tag::PlaceObject(place) if frames == 0 => {
+                let PlaceObjectAction::Place(id) = place.action else {
+                    return Err("dynamic placement not supported".into());
+                };
+                let sprite = *chars
+                    .get(&id)
+                    .ok_or("unknown or forward character reference")?;
+                if (!root && sprite)
+                    || place.depth == 0
+                    || !depths.insert(place.depth)
+                    || place.version > 2
+                    || place.ratio.is_some()
+                    || place.clip_depth.is_some()
+                    || place.class_name.is_some()
+                    || place.filters.is_some()
+                    || place.background_color.is_some()
+                    || place.blend_mode.is_some()
+                    || place.clip_actions.is_some()
+                    || place.has_image
+                    || place.is_bitmap_cached.is_some()
+                    || place.amf_data.is_some()
+                {
+                    return Err("unsupported placement state".into());
+                }
+                if let Some(name) = place.name {
+                    let name = std::str::from_utf8(name.as_bytes())
+                        .map_err(|_| "non-ASCII instance name")?;
+                    if !instance_name(name) || !names.insert(name.to_owned()) {
+                        return Err("invalid/duplicate instance name".into());
+                    }
+                    if root && sprite {
+                        targets.insert(name.to_owned());
+                    }
+                } else if root && sprite {
+                    return Err("root sprite requires a stable name".into());
+                }
+            }
+            _ => return Err(format!("unsupported SWF tag: {tag:?}")),
+        }
+    }
+    if frames == 0 || frames != expected_frames {
+        return Err("frame count mismatch".into());
+    }
+    Ok(())
+}
+
+#[derive(Clone)]
+enum Operand {
+    Number(Option<f64>),
+    Name(String),
+    KeyBinding,
+}
+fn number(stack: &mut Vec<Operand>) -> Result<Option<f64>, String> {
+    match stack.pop() {
+        Some(Operand::Number(n)) => Ok(n),
+        _ => Err("numeric operand required".into()),
+    }
+}
+fn name(stack: &mut Vec<Operand>) -> Result<String, String> {
+    match stack.pop() {
+        Some(Operand::Name(n)) => Ok(n),
+        _ => Err("literal name operand required".into()),
+    }
+}
+fn target(stack: &mut Vec<Operand>, targets: &HashSet<String>) -> Result<(), String> {
+    let target = name(stack)?;
+    if target.is_empty() || targets.contains(&target) {
+        Ok(())
+    } else {
+        Err("unknown static target".into())
+    }
+}
+fn property(stack: &mut Vec<Operand>) -> Result<(), String> {
+    match number(stack)? {
+        Some(0.0 | 1.0) => Ok(()),
+        _ => Err("only x/y display properties are supported".into()),
+    }
+}
+fn validate_actions(bytes: &[u8], targets: &HashSet<String>) -> Result<(), String> {
+    let mut reader = swf::avm1::read::Reader::new(bytes, 7);
+    let mut stack = Vec::new();
+    let mut ended = false;
+    while !reader.get_ref().is_empty() {
+        match reader.read_action().map_err(|e| e.to_string())? {
+            Action::End => {
+                ended = true;
+                if !reader.get_ref().is_empty() {
+                    return Err("bytes after action end".into());
+                }
+            }
+            Action::Push(push) => {
+                for value in push.values {
+                    stack.push(match value {
+                        Value::Int(n) => Operand::Number(Some(f64::from(n))),
+                        Value::Float(n) => Operand::Number(Some(f64::from(n))),
+                        Value::Double(n) => Operand::Number(Some(n)),
+                        Value::Str(n) => Operand::Name(
+                            std::str::from_utf8(n.as_bytes())
+                                .map_err(|_| "non-ASCII literal")?
+                                .into(),
+                        ),
+                        _ => return Err("unsupported push value".into()),
+                    });
+                }
+            }
+            Action::GetVariable => {
+                let variable = name(&mut stack)?;
+                if variable == "Key" {
+                    stack.push(Operand::KeyBinding);
+                } else if state_name(&variable) {
+                    stack.push(Operand::Number(None));
+                } else {
+                    return Err("read outside sealed state namespace".into());
+                }
+            }
+            Action::CallMethod => {
+                if name(&mut stack)? != "isDown"
+                    || !matches!(stack.pop(), Some(Operand::KeyBinding))
+                    || number(&mut stack)? != Some(1.0)
+                    || !matches!(number(&mut stack)?, Some(37.0 | 39.0))
+                {
+                    return Err(
+                        "only Key.isDown with literal arrow-key argument is supported".into(),
+                    );
+                }
+                stack.push(Operand::Number(None));
+            }
+            Action::SetVariable => {
+                number(&mut stack)?;
+                if !state_name(&name(&mut stack)?) {
+                    return Err("write outside sealed state namespace".into());
+                }
+            }
+            Action::GetProperty => {
+                property(&mut stack)?;
+                target(&mut stack, targets)?;
+                stack.push(Operand::Number(None));
+            }
+            Action::SetProperty => {
+                number(&mut stack)?;
+                property(&mut stack)?;
+                target(&mut stack, targets)?;
+            }
+            Action::Add
+            | Action::Subtract
+            | Action::Multiply
+            | Action::Divide
+            | Action::Modulo
+            | Action::Less
+            | Action::Greater
+            | Action::Equals
+            | Action::And
+            | Action::Or => {
+                number(&mut stack)?;
+                number(&mut stack)?;
+                stack.push(Operand::Number(None));
+            }
+            Action::RandomNumber
+            | Action::Increment
+            | Action::Decrement
+            | Action::ToNumber
+            | Action::Not => {
+                number(&mut stack)?;
+                stack.push(Operand::Number(None));
+            }
+            Action::Trace => {
+                number(&mut stack)?;
+            }
+            Action::Pop => {
+                stack.pop().ok_or("stack underflow")?;
+            }
+            Action::PushDuplicate => {
+                stack.push(stack.last().cloned().ok_or("stack underflow")?);
+            }
+            Action::StackSwap => {
+                let n = stack.len();
+                if n < 2 {
+                    return Err("stack underflow".into());
+                }
+                stack.swap(n - 1, n - 2);
+            }
+            Action::Stop | Action::Play => (),
+            action => return Err(format!("unsupported AVM1 instruction: {action:?}")),
+        }
+        if stack.len() > 1024 {
+            return Err("operand stack limit".into());
+        }
+    }
+    if !ended || !stack.is_empty() {
+        return Err("action block must end with an empty stack".into());
+    }
+    Ok(())
+}
diff --git a/core/src/player/portable_snapshot/render_probe.rs b/core/src/player/portable_snapshot/render_probe.rs
new file mode 100644
index 00000000..cd5116e7
--- /dev/null
+++ b/core/src/player/portable_snapshot/render_probe.rs
@@ -0,0 +1,326 @@
+//! Test-only recorder of the commands produced by the real Ruffle renderer.
+//! Unsupported drawing features deliberately panic rather than create false evidence.
+
+use std::any::Any;
+use std::borrow::Cow;
+use std::fmt::Write;
+use std::num::NonZeroU32;
+use std::sync::{Arc, Mutex};
+
+use ruffle_render::backend::{
+    BitmapCacheEntry, Context3D, Context3DProfile, PixelBenderOutput, PixelBenderTarget,
+    RenderBackend, ShapeHandle, ShapeHandleImpl, ViewportDimensions,
+};
+use ruffle_render::bitmap::{
+    Bitmap, BitmapHandle, BitmapSource, PixelRegion, RgbaBufRead, SyncHandle,
+};
+use ruffle_render::commands::{Command, CommandList};
+use ruffle_render::error::Error;
+use ruffle_render::filters::Filter;
+use ruffle_render::matrix::Matrix;
+use ruffle_render::pixel_bender::{PixelBenderShader, PixelBenderShaderHandle};
+use ruffle_render::pixel_bender_support::PixelBenderShaderArgument;
+use ruffle_render::quality::StageQuality;
+use ruffle_render::shape_utils::{DistilledShape, DrawCommand, DrawPath, FillRule};
+use swf::{Color, FillStyle};
+
+#[derive(Debug)]
+struct RecordedPath {
+    data: String,
+    color: Color,
+    rule: &'static str,
+}
+
+#[derive(Debug)]
+struct RecordedShape(Vec<RecordedPath>);
+impl ShapeHandleImpl for RecordedShape {}
+
+struct Recording {
+    dimensions: ViewportDimensions,
+    svg: Option<String>,
+    digest: Option<String>,
+    shape_count: usize,
+}
+
+/// Clones share the recorded output and viewport, but never contain a Player.
+#[derive(Clone)]
+pub(crate) struct RecordingRenderer(Arc<Mutex<Recording>>);
+
+impl RecordingRenderer {
+    pub(crate) fn new() -> Self {
+        Self(Arc::new(Mutex::new(Recording {
+            dimensions: ViewportDimensions {
+                width: 640,
+                height: 480,
+                scale_factor: 1.0,
+            },
+            svg: None,
+            digest: None,
+            shape_count: 0,
+        })))
+    }
+
+    pub(crate) fn render_svg(&self) -> String {
+        self.0
+            .lock()
+            .unwrap()
+            .svg
+            .clone()
+            .expect("Player::render must run first")
+    }
+
+    /// Exact canonical command description; intentionally not a lossy numeric hash.
+    pub(crate) fn digest(&self) -> String {
+        self.0
+            .lock()
+            .unwrap()
+            .digest
+            .clone()
+            .expect("Player::render must run first")
+    }
+
+    pub(crate) fn shape_count(&self) -> usize {
+        self.0.lock().unwrap().shape_count
+    }
+}
+
+fn matrix_svg(matrix: &Matrix) -> String {
+    format!(
+        "matrix({} {} {} {} {} {})",
+        f64::from(matrix.a),
+        f64::from(matrix.b),
+        f64::from(matrix.c),
+        f64::from(matrix.d),
+        matrix.tx.to_pixels(),
+        matrix.ty.to_pixels(),
+    )
+}
+
+fn color_svg(color: Color) -> String {
+    format!(
+        "fill=\"#{:02x}{:02x}{:02x}\" fill-opacity=\"{}\"",
+        color.r,
+        color.g,
+        color.b,
+        f64::from(color.a) / 255.0,
+    )
+}
+
+impl RenderBackend for RecordingRenderer {
+    fn viewport_dimensions(&self) -> ViewportDimensions {
+        self.0.lock().unwrap().dimensions
+    }
+
+    fn set_viewport_dimensions(&mut self, dimensions: ViewportDimensions) {
+        self.0.lock().unwrap().dimensions = dimensions;
+    }
+
+    fn register_shape(&mut self, shape: DistilledShape, _: &dyn BitmapSource) -> ShapeHandle {
+        let paths = shape
+            .paths
+            .into_iter()
+            .map(|path| {
+                let DrawPath::Fill {
+                    style,
+                    commands,
+                    winding_rule,
+                } = path
+                else {
+                    panic!("render probe does not support strokes");
+                };
+                let FillStyle::Color(color) = style else {
+                    panic!("render probe requires solid fills");
+                };
+                let mut data = String::new();
+                for command in commands {
+                    match command {
+                        DrawCommand::MoveTo(p) => {
+                            write!(data, "M{} {} ", p.x.to_pixels(), p.y.to_pixels()).unwrap()
+                        }
+                        DrawCommand::LineTo(p) => {
+                            write!(data, "L{} {} ", p.x.to_pixels(), p.y.to_pixels()).unwrap()
+                        }
+                        DrawCommand::QuadraticCurveTo { control, anchor } => write!(
+                            data,
+                            "Q{} {} {} {} ",
+                            control.x.to_pixels(),
+                            control.y.to_pixels(),
+                            anchor.x.to_pixels(),
+                            anchor.y.to_pixels(),
+                        )
+                        .unwrap(),
+                        DrawCommand::CubicCurveTo {
+                            control_a,
+                            control_b,
+                            anchor,
+                        } => write!(
+                            data,
+                            "C{} {} {} {} {} {} ",
+                            control_a.x.to_pixels(),
+                            control_a.y.to_pixels(),
+                            control_b.x.to_pixels(),
+                            control_b.y.to_pixels(),
+                            anchor.x.to_pixels(),
+                            anchor.y.to_pixels(),
+                        )
+                        .unwrap(),
+                    }
+                }
+                RecordedPath {
+                    data,
+                    color: *color,
+                    rule: match winding_rule {
+                        FillRule::EvenOdd => "evenodd",
+                        FillRule::NonZero => "nonzero",
+                    },
+                }
+            })
+            .collect();
+        ShapeHandle(Arc::new(RecordedShape(paths)))
+    }
+
+    fn submit_frame(
+        &mut self,
+        clear: Color,
+        commands: CommandList,
+        cache_entries: Vec<BitmapCacheEntry>,
+    ) {
+        assert!(
+            cache_entries.is_empty(),
+            "render probe does not support bitmap caching"
+        );
+        let dimensions = self.viewport_dimensions();
+        let mut svg = format!(
+            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{}\" height=\"{}\" viewBox=\"0 0 {} {}\">\n<rect width=\"100%\" height=\"100%\" {}/>\n",
+            dimensions.width,
+            dimensions.height,
+            dimensions.width,
+            dimensions.height,
+            color_svg(clear),
+        );
+        let mut digest = format!("viewport={dimensions:?};clear={clear:?}\n");
+        let mut shape_count = 0;
+        for command in commands.commands {
+            match command {
+                Command::RenderShape { shape, transform } => {
+                    assert!(
+                        transform.perspective_projection.is_none() && transform.tz == 0.0,
+                        "render probe does not support 3D transforms"
+                    );
+                    let shape = <dyn Any>::downcast_ref::<RecordedShape>(&*shape.0)
+                        .expect("render probe received a foreign shape handle");
+                    writeln!(
+                        digest,
+                        "shape={shape:?};matrix={:?};color={:?}",
+                        transform.matrix, transform.color_transform
+                    )
+                    .unwrap();
+                    for path in &shape.0 {
+                        let color = &transform.color_transform * path.color;
+                        writeln!(
+                            svg,
+                            "<path d=\"{}\" fill-rule=\"{}\" {} transform=\"{}\"/>",
+                            path.data,
+                            path.rule,
+                            color_svg(color),
+                            matrix_svg(&transform.matrix)
+                        )
+                        .unwrap();
+                    }
+                    shape_count += 1;
+                }
+                Command::DrawRect { color, matrix } => {
+                    writeln!(digest, "rect={color:?};matrix={matrix:?}").unwrap();
+                    writeln!(
+                        svg,
+                        "<rect width=\"1\" height=\"1\" {} transform=\"{}\"/>",
+                        color_svg(color),
+                        matrix_svg(&matrix)
+                    )
+                    .unwrap();
+                }
+                _ => panic!("render probe received an unsupported render command"),
+            }
+        }
+        svg.push_str("</svg>\n");
+        let mut recording = self.0.lock().unwrap();
+        recording.svg = Some(svg);
+        recording.digest = Some(digest);
+        recording.shape_count = shape_count;
+    }
+
+    fn render_offscreen(
+        &mut self,
+        _: BitmapHandle,
+        _: CommandList,
+        _: StageQuality,
+        _: PixelRegion,
+    ) -> Option<Box<dyn SyncHandle>> {
+        panic!("render probe does not support offscreen rendering")
+    }
+
+    fn apply_filter(
+        &mut self,
+        _: BitmapHandle,
+        _: (u32, u32),
+        _: (u32, u32),
+        _: BitmapHandle,
+        _: (i32, i32),
+        _: Filter,
+    ) -> Option<Box<dyn SyncHandle>> {
+        panic!("render probe does not support filters")
+    }
+
+    fn register_bitmap(&mut self, _: Bitmap<'_>) -> Result<BitmapHandle, Error> {
+        panic!("render probe does not support bitmaps")
+    }
+
+    fn update_texture(
+        &mut self,
+        _: &BitmapHandle,
+        _: Bitmap<'_>,
+        _: PixelRegion,
+    ) -> Result<(), Error> {
+        panic!("render probe does not support textures")
+    }
+
+    fn create_empty_texture(
+        &mut self,
+        _: NonZeroU32,
+        _: NonZeroU32,
+    ) -> Result<BitmapHandle, Error> {
+        panic!("render probe does not support textures")
+    }
+
+    fn create_context3d(&mut self, _: Context3DProfile) -> Result<Box<dyn Context3D>, Error> {
+        panic!("render probe does not support Stage3D")
+    }
+
+    fn debug_info(&self) -> Cow<'static, str> {
+        Cow::Borrowed("Sealed AVM1 actual-render command probe")
+    }
+    fn name(&self) -> &'static str {
+        "sealed-avm1-render-probe"
+    }
+    fn set_quality(&mut self, _: StageQuality) {}
+
+    fn compile_pixelbender_shader(
+        &mut self,
+        _: PixelBenderShader,
+    ) -> Result<PixelBenderShaderHandle, Error> {
+        panic!("render probe does not support Pixel Bender")
+    }
+
+    fn run_pixelbender_shader(
+        &mut self,
+        _: PixelBenderShaderHandle,
+        _: &[PixelBenderShaderArgument],
+        _: &PixelBenderTarget,
+    ) -> Result<PixelBenderOutput, Error> {
+        panic!("render probe does not support Pixel Bender")
+    }
+
+    fn resolve_sync_handle(&mut self, _: Box<dyn SyncHandle>, _: RgbaBufRead) -> Result<(), Error> {
+        panic!("render probe does not support sync handles")
+    }
+}
diff --git a/core/src/player/portable_snapshot/tests.rs b/core/src/player/portable_snapshot/tests.rs
new file mode 100644
index 00000000..7cf37867
--- /dev/null
+++ b/core/src/player/portable_snapshot/tests.rs
@@ -0,0 +1,565 @@
+use super::*;
+use swf::avm1::types::{Action, Push, Value};
+
+fn fixture(extra: Option<Action<'static>>) -> Vec<u8> {
+    let mut frames = Vec::new();
+    for frame in 0..240 {
+        let mut bytes = Vec::new();
+        let mut writer = swf::avm1::write::Writer::new(&mut bytes, 7);
+        let name = swf::SwfStr::from_utf8_str("s_score");
+        let input = swf::SwfStr::from_utf8_str("s_dx");
+        let mut actions = vec![Action::Push(Push {
+            values: vec![Value::Str(input)],
+        })];
+        // Real Flash Key.isDown calls: right minus left, eight pixels/frame.
+        for key in [39, 37] {
+            actions.extend([
+                Action::Push(Push {
+                    values: vec![
+                        Value::Int(key),
+                        Value::Int(1),
+                        Value::Str(swf::SwfStr::from_utf8_str("Key")),
+                    ],
+                }),
+                Action::GetVariable,
+                Action::Push(Push {
+                    values: vec![Value::Str(swf::SwfStr::from_utf8_str("isDown"))],
+                }),
+                Action::CallMethod,
+                Action::ToNumber,
+            ]);
+        }
+        actions.extend([
+            Action::Subtract,
+            Action::Push(Push {
+                values: vec![Value::Int(8)],
+            }),
+            Action::Multiply,
+            Action::SetVariable,
+            Action::Push(Push {
+                values: vec![Value::Str(name)],
+            }),
+        ]);
+        if frame == 0 {
+            actions.push(Action::Push(Push {
+                values: vec![Value::Int(0)],
+            }));
+        } else {
+            actions.extend([
+                Action::Push(Push {
+                    values: vec![Value::Str(name)],
+                }),
+                Action::GetVariable,
+                Action::Push(Push {
+                    values: vec![Value::Str(input)],
+                }),
+                Action::GetVariable,
+                Action::Add,
+                Action::Push(Push {
+                    values: vec![Value::Int(100)],
+                }),
+                Action::RandomNumber,
+                Action::Add,
+            ]);
+        }
+        actions.extend([
+            Action::SetVariable,
+            Action::Push(Push {
+                values: vec![Value::Str(name)],
+            }),
+            Action::GetVariable,
+            Action::Trace,
+        ]);
+        // Move the actual native MovieClip, not a stand-in world representation.
+        actions.extend([
+            Action::Push(Push {
+                values: vec![
+                    Value::Str(swf::SwfStr::from_utf8_str("clip_avatar")),
+                    Value::Int(0),
+                    Value::Str(swf::SwfStr::from_utf8_str("clip_avatar")),
+                    Value::Int(0),
+                ],
+            }),
+            Action::GetProperty,
+            Action::Push(Push {
+                values: vec![Value::Str(input)],
+            }),
+            Action::GetVariable,
+            Action::Add,
+            Action::Push(Push {
+                values: vec![Value::Int(640)],
+            }),
+            Action::Add,
+            Action::Push(Push {
+                values: vec![Value::Int(640)],
+            }),
+            Action::Modulo,
+            Action::SetProperty,
+        ]);
+        // Collect the gold square on overlap; the real AVM RNG chooses its next x.
+        let text = |s: &'static str| Value::Str(swf::SwfStr::from_utf8_str(s));
+        let push = |values| Action::Push(Push { values });
+        if frame == 0 {
+            actions.extend([
+                push(vec![text("s_collected"), Value::Int(0)]),
+                Action::SetVariable,
+            ]);
+        }
+        actions.extend([
+            push(vec![text("s_delta"), text("clip_avatar"), Value::Int(0)]),
+            Action::GetProperty,
+            push(vec![text("clip_goal"), Value::Int(0)]),
+            Action::GetProperty,
+            Action::Subtract,
+            Action::SetVariable,
+            push(vec![text("s_hit"), text("s_delta")]),
+            Action::GetVariable,
+            push(vec![text("s_delta")]),
+            Action::GetVariable,
+            Action::Multiply,
+            push(vec![Value::Int(1024)]),
+            Action::Less,
+            Action::ToNumber,
+            Action::SetVariable,
+            push(vec![text("s_collected"), text("s_collected")]),
+            Action::GetVariable,
+            push(vec![text("s_hit")]),
+            Action::GetVariable,
+            Action::Add,
+            Action::SetVariable,
+            push(vec![text("s_collected")]),
+            Action::GetVariable,
+            Action::Trace,
+            push(vec![
+                text("clip_goal"),
+                Value::Int(0),
+                text("clip_goal"),
+                Value::Int(0),
+            ]),
+            Action::GetProperty,
+            push(vec![Value::Int(1), text("s_hit")]),
+            Action::GetVariable,
+            Action::Subtract,
+            Action::Multiply,
+            push(vec![Value::Int(500)]),
+            Action::RandomNumber,
+            push(vec![Value::Int(50)]),
+            Action::Add,
+            push(vec![text("s_hit")]),
+            Action::GetVariable,
+            Action::Multiply,
+            Action::Add,
+            Action::SetProperty,
+        ]);
+        if let Some(action) = &extra {
+            actions.push(action.clone());
+        }
+        actions.push(Action::End);
+        for action in actions {
+            writer.write_action(&action).unwrap();
+        }
+        frames.push(bytes);
+    }
+    let mut tags = vec![
+        swf::Tag::SetBackgroundColor(swf::Color {
+            r: 20,
+            g: 27,
+            b: 45,
+            a: 255,
+        }),
+        swf::Tag::DefineShape(Box::new(square(
+            1,
+            swf::Color {
+                r: 64,
+                g: 220,
+                b: 210,
+                a: 255,
+            },
+        ))),
+        swf::Tag::DefineShape(Box::new(square(
+            3,
+            swf::Color {
+                r: 255,
+                g: 185,
+                b: 70,
+                a: 255,
+            },
+        ))),
+        swf::Tag::DefineSprite(swf::Sprite {
+            id: 2,
+            num_frames: 1,
+            tags: vec![place(1, 1, None, 0, 0), swf::Tag::ShowFrame],
+        }),
+        swf::Tag::DefineSprite(swf::Sprite {
+            id: 4,
+            num_frames: 1,
+            tags: vec![place(3, 1, None, 0, 0), swf::Tag::ShowFrame],
+        }),
+        place(2, 1, Some("clip_avatar"), 64, 180),
+        place(4, 2, Some("clip_goal"), 96, 180),
+    ];
+    for actions in &frames {
+        tags.extend([swf::Tag::DoAction(actions), swf::Tag::ShowFrame]);
+    }
+
+    let mut header = swf::Header::default_with_swf_version(7);
+    header.num_frames = frames.len() as u16;
+    header.frame_rate = swf::Fixed8::from_f32(24.0);
+    header.stage_size = swf::Rectangle {
+        x_min: swf::Twips::ZERO,
+        y_min: swf::Twips::ZERO,
+        x_max: swf::Twips::from_pixels(640.0),
+        y_max: swf::Twips::from_pixels(360.0),
+    };
+    let mut bytes = Vec::new();
+    swf::write_swf(&header, &tags, &mut bytes).unwrap();
+    bytes
+}
+
+fn square(id: u16, color: swf::Color) -> swf::Shape {
+    use swf::{PointDelta, ShapeRecord, Twips};
+    let bounds = swf::Rectangle {
+        x_min: Twips::ZERO,
+        y_min: Twips::ZERO,
+        x_max: Twips::new(640),
+        y_max: Twips::new(640),
+    };
+    swf::Shape {
+        version: 3,
+        id,
+        shape_bounds: bounds,
+        edge_bounds: bounds,
+        flags: swf::ShapeFlag::empty(),
+        styles: swf::ShapeStyles {
+            fill_styles: vec![swf::FillStyle::Color(color)],
+            line_styles: vec![],
+        },
+        shape: vec![
+            ShapeRecord::StyleChange(Box::new(swf::StyleChangeData {
+                move_to: Some(swf::Point::default()),
+                fill_style_0: Some(1),
+                fill_style_1: None,
+                line_style: None,
+                new_styles: None,
+            })),
+            ShapeRecord::StraightEdge {
+                delta: PointDelta {
+                    dx: Twips::new(640),
+                    dy: Twips::ZERO,
+                },
+            },
+            ShapeRecord::StraightEdge {
+                delta: PointDelta {
+                    dx: Twips::ZERO,
+                    dy: Twips::new(640),
+                },
+            },
+            ShapeRecord::StraightEdge {
+                delta: PointDelta {
+                    dx: Twips::new(-640),
+                    dy: Twips::ZERO,
+                },
+            },
+            ShapeRecord::StraightEdge {
+                delta: PointDelta {
+                    dx: Twips::ZERO,
+                    dy: Twips::new(-640),
+                },
+            },
+        ],
+    }
+}
+
+fn place(id: u16, depth: u16, name: Option<&'static str>, x: i32, y: i32) -> swf::Tag<'static> {
+    swf::Tag::PlaceObject(Box::new(swf::PlaceObject {
+        version: 2,
+        action: swf::PlaceObjectAction::Place(id),
+        depth,
+        matrix: Some(swf::Matrix {
+            tx: swf::Twips::new(x * 20),
+            ty: swf::Twips::new(y * 20),
+            ..Default::default()
+        }),
+        color_transform: None,
+        ratio: None,
+        name: name.map(swf::SwfStr::from_utf8_str),
+        clip_depth: None,
+        class_name: None,
+        filters: None,
+        background_color: None,
+        blend_mode: None,
+        clip_actions: None,
+        has_image: false,
+        is_bitmap_cached: None,
+        is_visible: None,
+        amf_data: None,
+    }))
+}
+
+#[test]
+fn portable_snapshot_actual_swf_continues_without_replay() {
+    let mut original = SealedAvm1Player::new(&fixture(None), 12345).unwrap();
+    original.set_arrow_keys(false, true).unwrap();
+    for _ in 0..4 {
+        original.step(&[]).unwrap();
+    }
+    let saved = original.checkpoint().unwrap();
+    let state: Checkpoint = serde_json::from_slice(&saved).unwrap();
+    assert_eq!(
+        state.display.root.timeline.as_ref().unwrap().current_frame,
+        4
+    );
+    assert_eq!(state.display.root.children[0].translation[0], 96 * 20);
+    assert_ne!(
+        state.display.root.children[1].translation[0],
+        96 * 20,
+        "collected goal must respawn through real SWF code"
+    );
+    let mut restored = SealedAvm1Player::restore(&saved).unwrap();
+    assert!(
+        restored.take_trace().is_empty(),
+        "restore must execute no frame scripts"
+    );
+    original.take_trace();
+    for input in [4.0, -1.0, 0.0, 8.0, 2.0] {
+        original.set_arrow_keys(input < 0.0, input > 0.0).unwrap();
+        restored.set_arrow_keys(input < 0.0, input > 0.0).unwrap();
+        original.step(&[]).unwrap();
+        restored.step(&[]).unwrap();
+    }
+    assert_eq!(original.take_trace(), restored.take_trace());
+    assert_eq!(
+        original.checkpoint().unwrap(),
+        restored.checkpoint().unwrap()
+    );
+    original.player.lock().unwrap().render();
+    restored.player.lock().unwrap().render();
+    assert_eq!(original.recorder.shape_count(), 2);
+    assert_eq!(original.recorder.digest(), restored.recorder.digest());
+}
