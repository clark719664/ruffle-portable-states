+#[test]
+fn portable_snapshot_process_helper() {
+    let Ok(mode) = std::env::var("RUFFLE_SEALED_MODE") else {
+        return;
+    };
+    let directory = std::path::PathBuf::from(std::env::var_os("RUFFLE_SEALED_DIR").unwrap());
+    let mut player = if mode == "produce" {
+        let movie = fixture(None);
+        std::fs::write(directory.join("interactive-world.swf"), &movie).unwrap();
+        let mut player = SealedAvm1Player::new(&movie, 12345).unwrap();
+        player.set_arrow_keys(false, true).unwrap();
+        for _ in 0..4 {
+            player.step(&[]).unwrap();
+        }
+        std::fs::write(
+            directory.join("checkpoint.json"),
+            player.checkpoint().unwrap(),
+        )
+        .unwrap();
+        player.player.lock().unwrap().render();
+        std::fs::write(
+            directory.join("checkpoint.svg"),
+            player.recorder.render_svg(),
+        )
+        .unwrap();
+        player
+    } else {
+        let player =
+            SealedAvm1Player::restore(&std::fs::read(directory.join("checkpoint.json")).unwrap())
+                .unwrap();
+        assert!(player.trace.0.lock().unwrap().is_empty());
+        player
+    };
+    player.take_trace();
+    // Held key survives restart, then release, reverse, and change direction.
+    let controls = std::iter::repeat_n((false, true), 28).chain([
+        (false, true),
+        (false, true),
+        (false, false),
+        (true, false),
+        (true, false),
+        (false, true),
+        (false, true),
+    ]);
+    for (left, right) in controls {
+        player.set_arrow_keys(left, right).unwrap();
+        player.step(&[]).unwrap();
+    }
+    player.player.lock().unwrap().render();
+    assert_eq!(player.recorder.shape_count(), 2);
+    let trace = player.take_trace();
+    assert!(
+        trace
+            .chunks_exact(2)
+            .any(|pair| pair[1].parse::<u32>().unwrap() >= 2),
+        "continuation must collect a target and cause another RNG respawn after the checkpoint"
+    );
+    let state = player.checkpoint().unwrap();
+    let digest = player.recorder.digest();
+    if mode == "produce" {
+        std::fs::write(
+            directory.join("expected-trace.json"),
+            serde_json::to_vec_pretty(&trace).unwrap(),
+        )
+        .unwrap();
+        std::fs::write(directory.join("expected-final.json"), &state).unwrap();
+        std::fs::write(directory.join("expected-render.txt"), &digest).unwrap();
+    } else {
+        assert_eq!(
+            trace,
+            serde_json::from_slice::<Vec<String>>(
+                &std::fs::read(directory.join("expected-trace.json")).unwrap()
+            )
+            .unwrap()
+        );
+        assert_eq!(
+            state,
+            std::fs::read(directory.join("expected-final.json")).unwrap()
+        );
+        assert_eq!(
+            digest,
+            std::fs::read_to_string(directory.join("expected-render.txt")).unwrap()
+        );
+        std::fs::write(directory.join("restored.svg"), player.recorder.render_svg()).unwrap();
+        std::fs::write(directory.join("verified.txt"), "Producer exited before consumer launched. Fresh Player restore executed zero frame scripts. Subsequent trace, heap, RNG, keyboard state, display tree, timeline and actual render command digest match exactly.\n").unwrap();
+    }
+}
