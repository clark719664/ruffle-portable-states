+#[test]
+fn portable_snapshot_rejects_corrupt_checkpoint_native_state() {
+    let mut player = SealedAvm1Player::new(&fixture(None), 15).unwrap();
+    player.step(&[]).unwrap();
+    let valid: serde_json::Value = serde_json::from_slice(&player.checkpoint().unwrap()).unwrap();
+    for (pointer, replacement) in [
+        ("/format", serde_json::json!("unknown-version")),
+        ("/rng", serde_json::json!(0)),
+        ("/completed_steps", serde_json::json!(0)),
+        (
+            "/display/root/timeline/tag_stream_pos",
+            serde_json::json!(1),
+        ),
+        ("/display/root/flags", serde_json::json!(u32::MAX)),
+        (
+            "/display/root/children/0/character_id",
+            serde_json::json!(65535),
+        ),
+        (
+            "/display/root/children/0/name",
+            serde_json::json!([75, 101, 121]),
+        ),
+        ("/display/root/children/0/depth", serde_json::json!(80)),
+        (
+            "/display/root/children/0/character_id",
+            serde_json::json!(4),
+        ),
+        ("/builtin_pool", serde_json::json!([])),
+    ] {
+        let mut damaged = valid.clone();
+        *damaged.pointer_mut(pointer).unwrap() = replacement;
+        assert!(
+            SealedAvm1Player::restore(&serde_json::to_vec(&damaged).unwrap()).is_err(),
+            "accepted {pointer}"
+        );
+    }
+    assert!(SealedAvm1Player::restore(b"{}").is_err());
+    assert!(SealedAvm1Player::restore(&vec![b' '; MAX_SAVE + 1]).is_err());
+    // A successful save must always fit the restore transport ceiling.
+    player.movie.resize(MAX_SAVE, 0);
+    assert!(player.checkpoint().is_err());
+}
