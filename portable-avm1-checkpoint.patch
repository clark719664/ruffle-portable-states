+#[test]
+fn portable_snapshot_crosses_timeline_loop_and_preserves_stop() {
+    for (extra, warmup, continuation) in [(None, 239, 5), (Some(Action::Stop), 1, 3)] {
+        let mut original = SealedAvm1Player::new(&fixture(extra), 948).unwrap();
+        original.set_arrow_keys(false, true).unwrap();
+        for _ in 0..warmup {
+            original.step(&[]).unwrap();
+        }
+        let mut restored = SealedAvm1Player::restore(&original.checkpoint().unwrap()).unwrap();
+        original.take_trace();
+        for _ in 0..continuation {
+            original.step(&[]).unwrap();
+            restored.step(&[]).unwrap();
+        }
+        assert_eq!(original.take_trace(), restored.take_trace());
+        assert_eq!(
+            original.checkpoint().unwrap(),
+            restored.checkpoint().unwrap()
+        );
+        // Capture and restore the state after wrapping (including persistent
+        // AVM1 LOOP_QUEUED), rather than only passing through the wrap once.
+        let mut after_wrap = SealedAvm1Player::restore(&original.checkpoint().unwrap()).unwrap();
+        original.take_trace();
+        original.step(&[]).unwrap();
+        after_wrap.step(&[]).unwrap();
+        assert_eq!(original.take_trace(), after_wrap.take_trace());
+        assert_eq!(
+            original.checkpoint().unwrap(),
+            after_wrap.checkpoint().unwrap()
+        );
+    }
