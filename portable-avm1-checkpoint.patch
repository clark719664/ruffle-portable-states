+#[test]
+fn portable_snapshot_producer_exit_consumer_restore_game_world() {
+    let directory = std::env::var_os("RUFFLE_PORTABLE_EXPORT")
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|| {
+            std::env::temp_dir().join(format!("ruffle-sealed-world-{}", std::process::id()))
+        });
+    std::fs::create_dir_all(&directory).unwrap();
+    for mode in ["produce", "consume"] {
+        let result = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "player::portable_snapshot::tests::portable_snapshot_process_helper",
+                "--nocapture",
+            ])
+            .env("RUFFLE_SEALED_MODE", mode)
+            .env("RUFFLE_SEALED_DIR", &directory)
+            .output()
+            .unwrap();
+        assert!(
+            result.status.success(),
+            "{mode} failed: {} {}",
+            String::from_utf8_lossy(&result.stdout),
+            String::from_utf8_lossy(&result.stderr)
+        );
+    }
+}
