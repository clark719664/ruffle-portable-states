@@ -0,0 +1,253 @@
+//! Portable codec for AVM1 ordinary-object graphs, not execution checkpoints.
+//!
+//! This deliberately rejects native objects, functions, display objects,
+//! virtual properties, watchers and interfaces. A Player root is unsupported.
+//! Numeric bits and UTF-16 units avoid JSON's lossy number/string conversions.
+use super::{Attribute, AvmString, Mutation, NativeObject, Object, Property, Value};
+use crate::string::WString;
+use serde::{Deserialize, Serialize};
+use std::collections::{HashMap, HashSet};
+
+/// Versioned, address-free ordinary-object heap graph.
+///
+/// The representation contains no GC references and may outlive its arena.
+/// It is a prerequisite for, and must not be presented as, a Player snapshot.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HeapSnapshot {
+    version: u32,
+    root: u32,
+    objects: Vec<SavedObject>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SavedObject {
+    // Flash enumeration order: most recently inserted first.
+    properties: Vec<SavedProperty>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SavedProperty {
+    name: Vec<u16>,
+    attributes: u16,
+    value: SavedValue,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum SavedValue {
+    Undefined,
+    Null,
+    Bool(bool),
+    NumberBits(u64),
+    String(Vec<u16>),
+    Object(u32),
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum HeapSnapshotError {
+    #[error("unsupported object {object}: {state}")]
+    Unsupported { object: u32, state: &'static str },
+    #[error("invalid heap snapshot: {0}")]
+    Invalid(&'static str),
+}
+
+impl HeapSnapshot {
+    /// The sealed movie policy proves builtin/native bindings cannot be mutated.
+    /// Only its protected scalar namespace is copied; the fresh root retains its
+    /// freshly allocated MovieClip and builtin prototype bindings.
+    pub(crate) fn capture_sealed<'gc>(
+        root: Object<'gc>,
+        mc: &Mutation<'gc>,
+    ) -> Result<Self, HeapSnapshotError> {
+        let plain = Object::new_without_proto(mc);
+        let data = root.0.borrow();
+        let properties: Vec<_> = data.properties.iter().collect();
+        for (name, property) in properties.into_iter().rev() {
+            if name.to_utf8_lossy().starts_with("s_") {
+                if property.is_virtual()
+                    || !matches!(
+                        property.data(),
+                        Value::Number(_) | Value::Bool(_) | Value::Undefined
+                    )
+                {
+                    return Err(HeapSnapshotError::Invalid("non-scalar sealed property"));
+                }
+                plain
+                    .0
+                    .borrow_mut(mc)
+                    .properties
+                    .insert(name, property.clone(), true);
+            }
+        }
+        Self::capture(plain)
+    }
+
+    pub(crate) fn restore_sealed<'gc>(
+        &self,
+        root: Object<'gc>,
+        mc: &Mutation<'gc>,
+    ) -> Result<(), HeapSnapshotError> {
+        self.validate()?;
+        if self.objects.len() != 1 || self.root != 0 {
+            return Err(HeapSnapshotError::Invalid(
+                "sealed heap must contain one object",
+            ));
+        }
+        for property in &self.objects[0].properties {
+            let name = String::from_utf16(&property.name)
+                .map_err(|_| HeapSnapshotError::Invalid("invalid sealed name"))?;
+            if name.len() <= 2
+                || name.len() > 128
+                || !name.starts_with("s_")
+                || !name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+                || property.attributes != 0
+                || !matches!(
+                    property.value,
+                    SavedValue::NumberBits(_) | SavedValue::Bool(_) | SavedValue::Undefined
+                )
+            {
+                return Err(HeapSnapshotError::Invalid("invalid sealed property"));
+            }
+        }
+        let plain = self.restore(mc)?;
+        let data = plain.0.borrow();
+        let properties: Vec<_> = data.properties.iter().collect();
+        for (name, property) in properties.into_iter().rev() {
+            root.0
+                .borrow_mut(mc)
+                .properties
+                .insert(name, property.clone(), true);
+        }
+        Ok(())
+    }
+
+    /// Copy reachable stored own properties without executing ActionScript.
+    ///
+    /// All references, including __proto__, are traversed. Reaching a builtin
+    /// native function therefore rejects capture rather than dropping it.
+    pub fn capture(root: Object<'_>) -> Result<Self, HeapSnapshotError> {
+        let mut pending = vec![root];
+        let mut ids = HashMap::from([(root.as_ptr(), 0u32)]);
+        let mut objects = Vec::new();
+        // Iterate rather than recurse so deep and cyclic graphs use no call stack.
+        while objects.len() < pending.len() {
+            let index = objects.len();
+            let id = index as u32;
+            let object = pending[index];
+            let data = object.0.borrow();
+            let reject = |state| HeapSnapshotError::Unsupported { object: id, state };
+            if !matches!(data.native, NativeObject::None) {
+                return Err(reject("native payload"));
+            }
+            if data.interfaces.is_some() {
+                return Err(reject("interface list"));
+            }
+            if data.watchers.iter().next().is_some() {
+                return Err(reject("watchers"));
+            }
+            let mut properties = Vec::new();
+            for (name, property) in data.properties.iter() {
+                // Check both slots even if is_virtual() only checks the getter.
+                if property.getter().is_some() || property.setter().is_some() {
+                    return Err(reject("virtual property"));
+                }
+                let value = match property.data() {
+                    Value::Undefined => SavedValue::Undefined,
+                    Value::Null => SavedValue::Null,
+                    Value::Bool(value) => SavedValue::Bool(value),
+                    Value::Number(value) => SavedValue::NumberBits(value.to_bits()),
+                    Value::String(value) => SavedValue::String(value.iter().collect()),
+                    Value::Object(value) => {
+                        let next_id = u32::try_from(pending.len())
+                            .map_err(|_| HeapSnapshotError::Invalid("too many objects"))?;
+                        let reference = *ids.entry(value.as_ptr()).or_insert_with(|| {
+                            pending.push(value);
+                            next_id
+                        });
+                        SavedValue::Object(reference)
+                    }
+                    Value::MovieClip(_) => return Err(reject("MovieClip reference")),
+                };
+                properties.push(SavedProperty {
+                    name: name.iter().collect(),
+                    attributes: property.attributes().bits(),
+                    value,
+                });
+            }
+            objects.push(SavedObject { properties });
+        }
+        Ok(Self {
+            version: 1,
+            root: 0,
+            objects,
+        })
+    }
+
+    /// Allocate a new graph in the supplied arena, with no replay or host calls.
+    ///
+    /// Validate structural errors before making any GC allocations. Callers
+    /// should bound the size of serialized input before deserializing it.
+    pub fn restore<'gc>(&self, mc: &Mutation<'gc>) -> Result<Object<'gc>, HeapSnapshotError> {
+        self.validate()?;
+        // Allocate every identity before linking edges to preserve cycles/aliases.
+        let objects: Vec<_> = self
+            .objects
+            .iter()
+            .map(|_| Object::new_without_proto(mc))
+            .collect();
+        for (saved, object) in self.objects.iter().zip(&objects) {
+            let mut data = object.0.borrow_mut(mc);
+            // PropertyMap::iter reverses insertion order; insert in reverse again.
+            for property in saved.properties.iter().rev() {
+                let value = match &property.value {
+                    SavedValue::Undefined => Value::Undefined,
+                    SavedValue::Null => Value::Null,
+                    SavedValue::Bool(value) => Value::Bool(*value),
+                    SavedValue::NumberBits(bits) => Value::Number(f64::from_bits(*bits)),
+                    SavedValue::String(units) => {
+                        Value::String(AvmString::new(mc, WString::from_buf(units.clone())))
+                    }
+                    SavedValue::Object(id) => Value::Object(objects[*id as usize]),
+                };
+                data.properties.insert(
+                    AvmString::new(mc, WString::from_buf(property.name.clone())),
+                    Property::new_stored(value, Attribute::from_bits_retain(property.attributes)),
+                    true,
+                );
+            }
+        }
+        Ok(objects[self.root as usize])
+    }
+
+    fn validate(&self) -> Result<(), HeapSnapshotError> {
+        let invalid = HeapSnapshotError::Invalid;
+        if self.version != 1 {
+            return Err(invalid("unsupported version"));
+        }
+        if self.root as usize >= self.objects.len() {
+            return Err(invalid("root reference out of range"));
+        }
+        if self.objects.len() > u32::MAX as usize {
+            return Err(invalid("too many objects"));
+        }
+        for object in &self.objects {
+            let mut names = HashSet::new();
+            for property in &object.properties {
+                if !names.insert(&property.name) {
+                    return Err(invalid("duplicate property name"));
+                }
+                if Attribute::from_bits(property.attributes).is_none() {
+                    return Err(invalid("unknown property attributes"));
+                }
+                if let SavedValue::Object(id) = property.value {
+                    if id as usize >= self.objects.len() {
+                        return Err(invalid("object reference out of range"));
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
