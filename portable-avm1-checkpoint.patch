+    pub(crate) fn portable_timeline_capture(
+        self,
+    ) -> Result<super::portable_snapshot::TimelineSnapshot, String> {
+        let cell = self.0.cell.borrow();
+        if self.movie().is_action_script_3()
+            || self.0.object1.get().is_none()
+            || self.0.object2.get().is_some()
+            || self.0.drop_target.get().is_some()
+            || self.0.hit_area.get().is_some()
+            || !self.0.queued_tags.borrow().is_empty()
+            || self.0.attached_audio.get().is_some()
+            || self.0.audio_stream.get().is_some()
+            || !self.clip_actions().is_empty()
+            || !self.0.clip_event_flags.get().is_empty()
+            || self.0.drawing.get().is_some()
+            || self.0.queued_goto.get().is_some()
+            || self.0.has_pending_script.get()
+            || self.0.button_mode.get()
+            || !self.0.avm2_enabled.get()
+            || !self.0.avm2_use_hand_cursor.get()
+            || !cell.frame_scripts.is_empty()
+            || !cell.avm1_text_field_bindings.is_empty()
+        {
+            return Err("unsupported MovieClip runtime state".into());
+        }
+        let snapshot = super::portable_snapshot::TimelineSnapshot {
+            tag_stream_pos: self.0.tag_stream_pos.get(),
+            current_frame: self.0.current_frame.get(),
+            flags: self.0.flags.get().bits(),
+            queued_script_frame: self.0.queued_script_frame.get(),
+            last_queued_script_frame: self.0.last_queued_script_frame.get(),
+        };
+        self.portable_timeline_validate(&snapshot)?;
+        Ok(snapshot)
+    }
+
+    pub(crate) fn portable_timeline_validate(
+        self,
+        snapshot: &super::portable_snapshot::TimelineSnapshot,
+    ) -> Result<(), String> {
+        let allowed = MovieClipFlags::INITIALIZED
+            | MovieClipFlags::PLAYING
+            | MovieClipFlags::POST_INSTANTIATED
+            // run_goto sets this for every implicit loop, including AVM1;
+            // only the AVM2 construct_frame path clears it afterwards.
+            | MovieClipFlags::LOOP_QUEUED;
+        if self.movie().is_action_script_3()
+            || snapshot.flags & !allowed.bits() != 0
+            || snapshot.flags & MovieClipFlags::POST_INSTANTIATED.bits() == 0
+            || snapshot.flags & MovieClipFlags::INITIALIZED.bits() == 0
+            || (snapshot.flags & MovieClipFlags::LOOP_QUEUED.bits() != 0
+                && self.header_frames() <= 1)
+            || snapshot.current_frame == 0
+            || snapshot.current_frame > self.header_frames()
+            || snapshot.queued_script_frame != snapshot.current_frame
+            || snapshot.last_queued_script_frame.is_some()
+        {
+            return Err(format!(
+                "invalid portable MovieClip timeline state: id={} header_frames={} snapshot={snapshot:?}",
+                self.id(),
+                self.header_frames()
+            ));
+        }
+        // Validate against actual ShowFrame boundaries, not just a byte bound:
+        // accepting a cursor inside an action/tag would change continuation.
+        let shared = self.0.shared.get();
+        let data = shared.swf_data.as_ref();
+        let mut position = 0usize;
+        let mut frame = 0u16;
+        while position < data.len() {
+            let header = data
+                .get(position..position + 2)
+                .ok_or("truncated timeline tag header")?;
+            let header = u16::from_le_bytes([header[0], header[1]]);
+            position += 2;
+            let code = header >> 6;
+            let mut length = usize::from(header & 63);
+            if length == 63 {
+                let size = data
+                    .get(position..position + 4)
+                    .ok_or("truncated timeline tag length")?;
+                length = u32::from_le_bytes([size[0], size[1], size[2], size[3]]) as usize;
+                position += 4;
+            }
+            position = position
+                .checked_add(length)
+                .filter(|end| *end <= data.len())
+                .ok_or("timeline tag exceeds movie data")?;
+            if code == 0 {
+                // A one-frame clip takes NextFrame::Same on its second tick:
+                // it stops, then consumes its final End tag before returning.
+                if length == 0
+                    && self.header_frames() == 1
+                    && frame == snapshot.current_frame
+                    && snapshot.flags & MovieClipFlags::PLAYING.bits() == 0
+                    && data.len() as u64 == snapshot.tag_stream_pos
+                    // The SWF writer appends an implicit End, so input that
+                    // includes an explicit End has two. The runtime consumes
+                    // all of these. Accept only complete zero-length End tags.
+                    && (data.len() - position) % 2 == 0
+                    && data[position..].iter().all(|byte| *byte == 0)
+                {
+                    return Ok(());
+                }
+                break;
+            }
+            if code == 1 {
+                frame = frame.checked_add(1).ok_or("too many timeline frames")?;
+                if frame == snapshot.current_frame {
+                    if position as u64 == snapshot.tag_stream_pos {
+                        return Ok(());
+                    }
+                }
+            } else if frame == snapshot.current_frame {
+                // Only the final End tag may extend a completed frame cursor.
+                return Err("portable timeline cursor is not the saved frame boundary".into());
+            }
+        }
+        Err(format!(
+            "saved timeline frame is absent from movie data: id={} header_frames={} parsed_frame={frame} parsed_position={position} data_len={} snapshot={snapshot:?}",
+            self.id(),
+            self.header_frames(),
+            data.len()
+        ))
+    }
+
+    pub(crate) fn portable_timeline_restore(
+        self,
+        snapshot: &super::portable_snapshot::TimelineSnapshot,
+    ) -> Result<(), String> {
+        self.portable_timeline_validate(snapshot)?;
+        self.0.tag_stream_pos.set(snapshot.tag_stream_pos);
+        self.0.current_frame.set(snapshot.current_frame);
+        self.0
+            .flags
+            .set(MovieClipFlags::from_bits_retain(snapshot.flags));
+        self.0.queued_script_frame.set(snapshot.queued_script_frame);
+        self.0
+            .last_queued_script_frame
+            .set(snapshot.last_queued_script_frame);
+        Ok(())
+    }
+
     pub fn forced_button_mode(self) -> bool {
         self.0.button_mode.get()
     }
diff --git a/core/src/display_object/portable_snapshot.rs b/core/src/display_object/portable_snapshot.rs
new file mode 100644
index 00000000..a31feb6f
--- /dev/null
+++ b/core/src/display_object/portable_snapshot.rs
@@ -0,0 +1,449 @@
+//! Portable state for the sealed AVM1 static display-tree subset.
+//!
+//! This restores instances from preloaded immutable definitions. It never advances
+//! a timeline or executes a frame. The caller must validate the source SWF policy.
+use super::{
+    DisplayObject, DisplayObjectFlags, MovieClip, SoundTransform, TDisplayObject,
+    TDisplayObjectContainer,
+};
+use crate::context::UpdateContext;
+use crate::string::{AvmString, WStr};
+use crate::types::{Degrees, Percent};
+use crate::vminterface::Instantiator;
+use ruffle_render::matrix::Matrix;
+use ruffle_render::perspective_projection::PerspectiveProjection;
+use serde::{Deserialize, Serialize};
+use swf::{ColorTransform, Fixed8, Twips};
+
+const MAX_NODES: usize = 4096;
+const MAX_DEPTH: usize = 64;
+const ALLOWED_BASE_FLAGS: u32 =
+    (1 << 1) | (1 << 2) | (1 << 3) | (1 << 5) | (1 << 6) | (1 << 10) | (1 << 12) | (1 << 16);
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct DisplayTreeSnapshot {
+    pub root: DisplayNodeSnapshot,
+    /// Tree paths (display depths), in exact AVM1 execution order.
+    pub execution_order: Vec<Vec<i32>>,
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct DisplayNodeSnapshot {
+    pub character_id: u16,
+    pub depth: i32,
+    pub place_frame: u16,
+    pub name: Option<Vec<u16>>,
+    /// IEEE-754 bits, to preserve exact transforms across JSON transports.
+    pub matrix: [u32; 4],
+    pub translation: [i32; 2],
+    pub color_transform: [i16; 8],
+    /// Rotation degrees, x/y scale percent, skew (IEEE-754 bits).
+    pub transform_cache: [u64; 4],
+    pub flags: u32,
+    pub timeline: Option<TimelineSnapshot>,
+    pub children: Vec<DisplayNodeSnapshot>,
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct TimelineSnapshot {
+    pub tag_stream_pos: u64,
+    pub current_frame: u16,
+    pub flags: u8,
+    pub queued_script_frame: u16,
+    pub last_queued_script_frame: Option<u16>,
+}
+
+pub(crate) fn capture<'gc>(
+    root: MovieClip<'gc>,
+    context: &UpdateContext<'gc>,
+) -> Result<DisplayTreeSnapshot, String> {
+    let mut nodes = Vec::new();
+    let mut count = 0;
+    let root_state = capture_node(root.into(), &mut nodes, Vec::new(), 0, &mut count)?;
+    let mut execution_order = Vec::new();
+    let mut next = context.avm1.portable_exec_head();
+    while let Some(clip) = next {
+        let (_, path) = nodes
+            .iter()
+            .find(|(node, _)| DisplayObject::ptr_eq(*node, clip))
+            .ok_or("execution list contains a clip outside the saved display tree")?;
+        if execution_order.contains(path) {
+            return Err("cyclic AVM1 execution list".into());
+        }
+        execution_order.push(path.clone());
+        next = clip.next_avm1_clip();
+    }
+    if execution_order.len() != nodes.len() {
+        return Err("display clips missing from AVM1 execution list".into());
+    }
+    Ok(DisplayTreeSnapshot {
+        root: root_state,
+        execution_order,
+    })
+}
+
+fn capture_node<'gc>(
+    node: DisplayObject<'gc>,
+    clips: &mut Vec<(MovieClip<'gc>, Vec<i32>)>,
+    path: Vec<i32>,
+    level: usize,
+    count: &mut usize,
+) -> Result<DisplayNodeSnapshot, String> {
+    *count += 1;
+    if level > MAX_DEPTH || *count > MAX_NODES {
+        return Err("display tree exceeds portable limits".into());
+    }
+    let base = node.base();
+    let cell = base.cell.borrow();
+    let mut unsupported = Vec::new();
+    macro_rules! reject {
+        ($condition:expr, $field:literal) => {
+            if $condition {
+                unsupported.push($field);
+            }
+        };
+    }
+    reject!(base.flags.get().bits() & !ALLOWED_BASE_FLAGS != 0, "flags");
+    reject!(!cell.filters.is_empty(), "filters");
+    reject!(cell.blend_shader.is_some(), "blend_shader");
+    reject!(cell.cache.is_some(), "cache");
+    reject!(base.clip_depth.get() != 0, "clip_depth");
+    reject!(base.ratio.get() != 0, "ratio");
+    reject!(base.masker.get().is_some(), "masker");
+    reject!(base.maskee.get().is_some(), "maskee");
+    reject!(base.meta_data.get().is_some(), "meta_data");
+    // set_root_movie installs this even for AVM1. It is derived from the
+    // immutable movie, and is already present on a fresh destination root.
+    let expected_projection = (level == 0).then(|| PerspectiveProjection {
+        field_of_view: 55.0,
+        center: (
+            node.movie().width().to_pixels() / 2.0,
+            node.movie().height().to_pixels() / 2.0,
+        ),
+    });
+    reject!(
+        base.perspective_projection.get() != expected_projection,
+        "perspective_projection"
+    );
+    reject!(base.tz.get() != 0.0, "tz");
+    reject!(base.scroll_rect.get().is_some(), "scroll_rect");
+    reject!(
+        base.next_scroll_rect.get() != Default::default(),
+        "next_scroll_rect"
+    );
+    reject!(
+        base.scaling_grid.get() != Default::default(),
+        "scaling_grid"
+    );
+    reject!(base.opaque_background.get().is_some(), "opaque_background");
+    reject!(base.blend_mode.get() != Default::default(), "blend_mode");
+    reject!(
+        base.sound_transform.get() != SoundTransform::default(),
+        "sound_transform"
+    );
+    reject!(node.object2().is_some(), "object2");
+    if !unsupported.is_empty() {
+        return Err(format!(
+            "unsupported display runtime state: path={path:?} id={} flags={:#x} fields={unsupported:?}",
+            node.id(),
+            base.flags.get().bits()
+        ));
+    }
+    let timeline = match node {
+        DisplayObject::MovieClip(clip) => {
+            if level != 0 && clip.header_frames() != 1 {
+                return Err("nested timelines must contain exactly one frame".into());
+            }
+            clips.push((clip, path.clone()));
+            Some(clip.portable_timeline_capture()?)
+        }
+        DisplayObject::Graphic(_) if level != 0 => None,
+        _ => return Err("unsupported display object kind".into()),
+    };
+    let mut children = Vec::new();
+    if let Some(container) = node.as_container() {
+        if container.num_children() > MAX_NODES {
+            return Err("too many display children".into());
+        }
+        let mut prior_depth = None;
+        for child in container.iter_render_list() {
+            if prior_depth.is_some_and(|depth| depth >= child.depth()) {
+                return Err("portable render order must equal unique depth order".into());
+            }
+            prior_depth = Some(child.depth());
+            let mut child_path = path.clone();
+            child_path.push(child.depth());
+            children.push(capture_node(child, clips, child_path, level + 1, count)?);
+        }
+    }
+    let matrix = base.matrix.get();
+    let color = base.color_transform.get();
+    let result = DisplayNodeSnapshot {
+        character_id: node.id(),
+        depth: node.depth(),
+        place_frame: node.place_frame(),
+        name: node.name().map(|name| name.iter().collect()),
+        matrix: [
+            matrix.a.to_bits(),
+            matrix.b.to_bits(),
+            matrix.c.to_bits(),
+            matrix.d.to_bits(),
+        ],
+        translation: [matrix.tx.get(), matrix.ty.get()],
+        color_transform: [
+            color.r_multiply.get(),
+            color.g_multiply.get(),
+            color.b_multiply.get(),
+            color.a_multiply.get(),
+            color.r_add,
+            color.g_add,
+            color.b_add,
+            color.a_add,
+        ],
+        transform_cache: [
+            f64::from(base.rotation.get()).to_bits(),
+            base.scale_x.get().percent().to_bits(),
+            base.scale_y.get().percent().to_bits(),
+            base.skew.get().to_bits(),
+        ],
+        flags: base.flags.get().bits(),
+        timeline,
+        children,
+    };
+    validate_scalars(&result, level == 0)?;
+    Ok(result)
+}
+
+fn validate_scalars(node: &DisplayNodeSnapshot, root: bool) -> Result<(), String> {
+    if node.flags & !ALLOWED_BASE_FLAGS != 0
+        || node.matrix.iter().any(|v| !f32::from_bits(*v).is_finite())
+        || node
+            .transform_cache
+            .iter()
+            .any(|v| !f64::from_bits(*v).is_finite())
+        || node.name.as_ref().is_some_and(|name| name.len() > 1024)
+        || (node.flags & DisplayObjectFlags::IS_ROOT.bits() != 0) != root
+        || (!root
+            && (node.character_id == 0
+                || !(1..=65535).contains(&node.depth)
+                || node.place_frame != 1))
+        || (root && node.timeline.is_none())
+        || (node.timeline.is_none() && !node.children.is_empty())
+    {
+        return Err("invalid portable display scalar state".into());
+    }
+    Ok(())
+}
+
+pub(crate) fn restore<'gc>(
+    root: MovieClip<'gc>,
+    snapshot: &DisplayTreeSnapshot,
+    context: &mut UpdateContext<'gc>,
+) -> Result<(), String> {
+    if root.num_children() != 0 || root.current_frame() != 0 {
+        return Err("display restore requires a fresh, unadvanced root".into());
+    }
+    let mut count = 0;
+    validate_tree(&snapshot.root, 0, &mut count)?;
+    if snapshot.root.character_id != root.id()
+        || snapshot.root.depth != root.depth()
+        || snapshot.root.place_frame != root.place_frame()
+        || snapshot.root.name != root.name().map(|name| name.iter().collect::<Vec<u16>>())
+    {
+        return Err("snapshot root does not match the loaded movie".into());
+    }
+    let mut clips = Vec::new();
+    restore_node(root.into(), &snapshot.root, context, &mut clips, Vec::new())?;
+    if snapshot.execution_order.len() != clips.len() {
+        return Err("invalid portable execution list length".into());
+    }
+    let mut ordered = Vec::new();
+    for path in &snapshot.execution_order {
+        let (clip, _) = clips
+            .iter()
+            .find(|(_, candidate)| candidate == path)
+            .ok_or("execution list path does not identify a saved clip")?;
+        if ordered
+            .iter()
+            .any(|prior| DisplayObject::ptr_eq(*prior, *clip))
+        {
+            return Err("duplicate clip in portable execution list".into());
+        }
+        ordered.push(*clip);
+    }
+    for (index, clip) in ordered.iter().enumerate() {
+        clip.set_next_avm1_clip(context.gc(), ordered.get(index + 1).copied());
+    }
+    context
+        .avm1
+        .set_portable_exec_head(ordered.first().copied());
+    Ok(())
+}
+
+fn validate_tree(
+    node: &DisplayNodeSnapshot,
+    level: usize,
+    count: &mut usize,
+) -> Result<(), String> {
+    *count += 1;
+    if level > MAX_DEPTH || *count > MAX_NODES {
+        return Err("display tree exceeds portable limits".into());
+    }
+    validate_scalars(node, level == 0)?;
+    let mut previous = None;
+    for child in &node.children {
+        if previous.is_some_and(|depth| depth >= child.depth) {
+            return Err("invalid child depth order".into());
+        }
+        previous = Some(child.depth);
+        validate_tree(child, level + 1, count)?;
+    }
+    Ok(())
+}
+
+fn restore_node<'gc>(
+    node: DisplayObject<'gc>,
+    snapshot: &DisplayNodeSnapshot,
+    context: &mut UpdateContext<'gc>,
+    clips: &mut Vec<(MovieClip<'gc>, Vec<i32>)>,
+    path: Vec<i32>,
+) -> Result<(), String> {
+    // Timeline placement installs explicit names before constructing AVM1
+    // objects. Do the same so construction consumes no instance-name counter.
+    if let Some(name) = &snapshot.name {
+        node.set_name(
+            context.gc(),
+            AvmString::new(context.gc(), WStr::from_units(name.as_slice())),
+        );
+    } else if snapshot.timeline.is_some() {
+        return Err("snapshot omitted an instantiated clip name".into());
+    }
+    match (node, &snapshot.timeline) {
+        (DisplayObject::MovieClip(clip), Some(timeline)) => {
+            if !path.is_empty() && clip.header_frames() != 1 {
+                return Err("nested timelines must contain exactly one frame".into());
+            }
+            clip.portable_timeline_validate(timeline)?;
+            // This creates the native object/prototype and execution-list entry,
+            // without entering a frame. The sealed policy excludes constructors.
+            clip.post_instantiation(context, None, Instantiator::Movie, false);
+            clips.push((clip, path.clone()));
+            for saved_child in &snapshot.children {
+                let child = context
+                    .library
+                    .library_for_movie_mut(clip.movie())
+                    .instantiate_by_id(saved_child.character_id, context.gc_context)
+                    .ok_or("saved display character is absent from the movie library")?;
+                clip.replace_at_depth(context, child, saved_child.depth);
+                let mut child_path = path.clone();
+                child_path.push(saved_child.depth);
+                restore_node(child, saved_child, context, clips, child_path)?;
+            }
+            clip.portable_timeline_restore(timeline)?;
+        }
+        (DisplayObject::Graphic(_), None) if snapshot.children.is_empty() => {}
+        _ => return Err("saved display kind does not match immutable character definition".into()),
+    }
+    if node.id() != snapshot.character_id {
+        return Err("display character id mismatch".into());
+    }
+    let base = node.base();
+    let m = snapshot.matrix.map(f32::from_bits);
+    node.set_matrix(Matrix {
+        a: m[0],
+        b: m[1],
+        c: m[2],
+        d: m[3],
+        tx: Twips::new(snapshot.translation[0]),
+        ty: Twips::new(snapshot.translation[1]),
+    });
+    let c = snapshot.color_transform;
+    node.set_color_transform(ColorTransform {
+        r_multiply: Fixed8::from_bits(c[0]),
+        g_multiply: Fixed8::from_bits(c[1]),
+        b_multiply: Fixed8::from_bits(c[2]),
+        a_multiply: Fixed8::from_bits(c[3]),
+        r_add: c[4],
+        g_add: c[5],
+        b_add: c[6],
+        a_add: c[7],
+    });
+    node.set_place_frame(snapshot.place_frame);
+    let cache = snapshot.transform_cache.map(f64::from_bits);
+    base.rotation.set(Degrees::from(cache[0]));
+    base.scale_x.set(Percent::from(cache[1]));
+    base.scale_y.set(Percent::from(cache[2]));
+    base.skew.set(cache[3]);
+    base.flags
+        .set(DisplayObjectFlags::from_bits_retain(snapshot.flags));
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn root() -> DisplayNodeSnapshot {
+        DisplayNodeSnapshot {
+            character_id: 0,
+            depth: 0,
+            place_frame: 0,
+            name: Some(vec![]),
+            matrix: [1.0_f32.to_bits(), 0, 0, 1.0_f32.to_bits()],
+            translation: [0, 0],
+            color_transform: [256, 256, 256, 256, 0, 0, 0, 0],
+            transform_cache: [0, 100.0_f64.to_bits(), 100.0_f64.to_bits(), 0],
+            flags: DisplayObjectFlags::IS_ROOT.bits() | DisplayObjectFlags::VISIBLE.bits(),
+            timeline: Some(TimelineSnapshot {
+                tag_stream_pos: 2,
+                current_frame: 1,
+                flags: 65,
+                queued_script_frame: 1,
+                last_queued_script_frame: None,
+            }),
+            children: vec![],
+        }
+    }
+
+    #[test]
+    fn rejects_unsupported_flags_and_nonfinite_transforms() {
+        let mut node = root();
+        assert!(validate_tree(&node, 0, &mut 0).is_ok());
+        node.flags |= DisplayObjectFlags::AVM1_PENDING_REMOVAL.bits();
+        assert!(validate_tree(&node, 0, &mut 0).is_err());
+        node = root();
+        node.matrix[0] = f32::NAN.to_bits();
+        assert!(validate_tree(&node, 0, &mut 0).is_err());
+    }
+
+    #[test]
+    fn rejects_duplicate_depths_and_nonroot_root_flags() {
+        let mut node = root();
+        let mut leaf = root();
+        leaf.character_id = 1;
+        leaf.depth = 1;
+        leaf.place_frame = 1;
+        leaf.flags = DisplayObjectFlags::VISIBLE.bits();
+        leaf.timeline = None;
+        node.children = vec![leaf.clone()];
+        assert!(validate_tree(&node, 0, &mut 0).is_ok());
+        node.children.push(leaf);
+        assert!(validate_tree(&node, 0, &mut 0).is_err());
+        node.children.pop();
+        node.children[0].flags |= DisplayObjectFlags::IS_ROOT.bits();
+        assert!(validate_tree(&node, 0, &mut 0).is_err());
+    }
+
+    #[test]
+    fn transport_preserves_exact_transform_bits() {
+        let mut node = root();
+        node.matrix[1] = (-0.0_f32).to_bits();
+        node.transform_cache[0] = (1.0_f64 / 7.0).to_bits();
+        let json = serde_json::to_string(&node).unwrap();
+        let restored: DisplayNodeSnapshot = serde_json::from_str(&json).unwrap();
+        assert_eq!(node, restored);
+    }
+}
