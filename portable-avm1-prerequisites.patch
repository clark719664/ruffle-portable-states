index 00000000..8f2342f7
--- /dev/null
+++ b/core/src/avm1/object/script_object/portable_snapshot.rs
@@ -0,0 +1,184 @@
+//! Portable codec for AVM1 ordinary-object graphs, not execution checkpoints.
+//!
+//! This deliberately rejects native objects, functions, display objects,
+//! virtual properties, watchers and interfaces. A Player root is unsupported.
+//! Numeric bits and UTF-16 units avoid JSON's lossy number/string conversions.
+use super::{Attribute, AvmString, Mutation, NativeObject, Object, Property, Value};
+use crate::string::WString;
+use serde::{Deserialize, Serialize};
+use std::collections::{HashMap, HashSet};
+
+/// Versioned, address-free ordinary-object heap graph.
+///
+/// The representation contains no GC references and may outlive its arena.
+/// It is a prerequisite for, and must not be presented as, a Player snapshot.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HeapSnapshot {
+    version: u32,
+    root: u32,
+    objects: Vec<SavedObject>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SavedObject {
+    // Flash enumeration order: most recently inserted first.
+    properties: Vec<SavedProperty>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SavedProperty {
+    name: Vec<u16>,
+    attributes: u16,
+    value: SavedValue,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum SavedValue {
+    Undefined,
+    Null,
+    Bool(bool),
+    NumberBits(u64),
+    String(Vec<u16>),
+    Object(u32),
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum HeapSnapshotError {
+    #[error("unsupported object {object}: {state}")]
+    Unsupported { object: u32, state: &'static str },
+    #[error("invalid heap snapshot: {0}")]
+    Invalid(&'static str),
+}
+
+impl HeapSnapshot {
+    /// Copy reachable stored own properties without executing ActionScript.
+    ///
+    /// All references, including __proto__, are traversed. Reaching a builtin
+    /// native function therefore rejects capture rather than dropping it.
+    pub fn capture(root: Object<'_>) -> Result<Self, HeapSnapshotError> {
+        let mut pending = vec![root];
+        let mut ids = HashMap::from([(root.as_ptr(), 0u32)]);
+        let mut objects = Vec::new();
+        // Iterate rather than recurse so deep and cyclic graphs use no call stack.
+        while objects.len() < pending.len() {
+            let index = objects.len();
+            let id = index as u32;
+            let object = pending[index];
+            let data = object.0.borrow();
+            let reject = |state| HeapSnapshotError::Unsupported { object: id, state };
+            if !matches!(data.native, NativeObject::None) {
+                return Err(reject("native payload"));
+            }
+            if data.interfaces.is_some() {
+                return Err(reject("interface list"));
+            }
+            if data.watchers.iter().next().is_some() {
+                return Err(reject("watchers"));
+            }
+            let mut properties = Vec::new();
+            for (name, property) in data.properties.iter() {
+                // Check both slots even if is_virtual() only checks the getter.
+                if property.getter().is_some() || property.setter().is_some() {
+                    return Err(reject("virtual property"));
+                }
+                let value = match property.data() {
+                    Value::Undefined => SavedValue::Undefined,
+                    Value::Null => SavedValue::Null,
+                    Value::Bool(value) => SavedValue::Bool(value),
+                    Value::Number(value) => SavedValue::NumberBits(value.to_bits()),
+                    Value::String(value) => SavedValue::String(value.iter().collect()),
+                    Value::Object(value) => {
+                        let next_id = u32::try_from(pending.len())
+                            .map_err(|_| HeapSnapshotError::Invalid("too many objects"))?;
+                        let reference = *ids.entry(value.as_ptr()).or_insert_with(|| {
+                            pending.push(value);
+                            next_id
+                        });
+                        SavedValue::Object(reference)
+                    }
+                    Value::MovieClip(_) => return Err(reject("MovieClip reference")),
+                };
+                properties.push(SavedProperty {
+                    name: name.iter().collect(),
+                    attributes: property.attributes().bits(),
+                    value,
+                });
+            }
+            objects.push(SavedObject { properties });
+        }
+        Ok(Self {
+            version: 1,
+            root: 0,
+            objects,
+        })
+    }
+
+    /// Allocate a new graph in the supplied arena, with no replay or host calls.
+    ///
+    /// Validate structural errors before making any GC allocations. Callers
+    /// should bound the size of serialized input before deserializing it.
+    pub fn restore<'gc>(&self, mc: &Mutation<'gc>) -> Result<Object<'gc>, HeapSnapshotError> {
+        self.validate()?;
+        // Allocate every identity before linking edges to preserve cycles/aliases.
+        let objects: Vec<_> = self
+            .objects
+            .iter()
+            .map(|_| Object::new_without_proto(mc))
+            .collect();
+        for (saved, object) in self.objects.iter().zip(&objects) {
+            let mut data = object.0.borrow_mut(mc);
+            // PropertyMap::iter reverses insertion order; insert in reverse again.
+            for property in saved.properties.iter().rev() {
+                let value = match &property.value {
+                    SavedValue::Undefined => Value::Undefined,
+                    SavedValue::Null => Value::Null,
+                    SavedValue::Bool(value) => Value::Bool(*value),
+                    SavedValue::NumberBits(bits) => Value::Number(f64::from_bits(*bits)),
+                    SavedValue::String(units) => {
+                        Value::String(AvmString::new(mc, WString::from_buf(units.clone())))
+                    }
+                    SavedValue::Object(id) => Value::Object(objects[*id as usize]),
+                };
+                data.properties.insert(
+                    AvmString::new(mc, WString::from_buf(property.name.clone())),
+                    Property::new_stored(value, Attribute::from_bits_retain(property.attributes)),
+                    true,
+                );
+            }
+        }
+        Ok(objects[self.root as usize])
+    }
+
+    fn validate(&self) -> Result<(), HeapSnapshotError> {
+        let invalid = HeapSnapshotError::Invalid;
+        if self.version != 1 {
+            return Err(invalid("unsupported version"));
+        }
+        if self.root as usize >= self.objects.len() {
+            return Err(invalid("root reference out of range"));
+        }
+        if self.objects.len() > u32::MAX as usize {
+            return Err(invalid("too many objects"));
+        }
+        for object in &self.objects {
+            let mut names = HashSet::new();
+            for property in &object.properties {
+                if !names.insert(&property.name) {
+                    return Err(invalid("duplicate property name"));
+                }
+                if Attribute::from_bits(property.attributes).is_none() {
+                    return Err(invalid("unknown property attributes"));
+                }
+                if let SavedValue::Object(id) = property.value {
+                    if id as usize >= self.objects.len() {
+                        return Err(invalid("object reference out of range"));
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
diff --git a/core/src/avm1/object/script_object/portable_snapshot_tests.rs b/core/src/avm1/object/script_object/portable_snapshot_tests.rs
new file mode 100644
index 00000000..42526541
--- /dev/null
+++ b/core/src/avm1/object/script_object/portable_snapshot_tests.rs
@@ -0,0 +1,189 @@
+//! Regression tests for the portable ordinary-object heap graph slice.
+use super::portable_snapshot::HeapSnapshot;
+use super::*;
+use gc_arena::arena::rootless_mutate;
+
+fn name<'gc>(mc: &Mutation<'gc>, value: &str) -> AvmString<'gc> {
+    AvmString::new_utf8(mc, value)
+}
+
+#[test]
+fn portable_snapshot_roundtrip_fresh_arena_preserves_graph_and_bits() {
+    let bytes = rootless_mutate(|mc| {
+        let root = Object::new_without_proto(mc);
+        let shared = Object::new_without_proto(mc);
+        root.define_value(mc, name(mc, "self"), root.into(), Attribute::empty());
+        root.define_value(mc, name(mc, "a"), shared.into(), Attribute::DONT_ENUM);
+        root.define_value(mc, name(mc, "b"), shared.into(), Attribute::READ_ONLY);
+        let nan = f64::from_bits(0x7ff8_0000_0000_0042);
+        shared.define_value(
+            mc,
+            name(mc, "nan"),
+            Value::Number(nan),
+            Attribute::DONT_DELETE,
+        );
+        shared.define_value(
+            mc,
+            name(mc, "negzero"),
+            Value::Number(-0.0),
+            Attribute::empty(),
+        );
+        shared.define_value(
+            mc,
+            name(mc, "utf16"),
+            Value::String(AvmString::new(
+                mc,
+                crate::string::WString::from_buf(vec![0xd800u16, 0, 0xdc00]),
+            )),
+            Attribute::empty(),
+        );
+        shared.define_value(
+            mc,
+            name(mc, "undefined"),
+            Value::Undefined,
+            Attribute::empty(),
+        );
+        shared.define_value(mc, name(mc, "null"), Value::Null, Attribute::empty());
+        shared.define_value(mc, name(mc, "bool"), Value::Bool(true), Attribute::empty());
+        serde_json::to_vec(&HeapSnapshot::capture(root).unwrap()).unwrap()
+    });
+    // The source arena has been dropped. Only portable bytes cross this boundary.
+    rootless_mutate(|mc| {
+        let saved: HeapSnapshot = serde_json::from_slice(&bytes).unwrap();
+        let root = saved.restore(mc).unwrap();
+        let read = root.0.borrow();
+        let get = |key: &str| read.properties.get(name(mc, key), true).unwrap().data();
+        assert!(matches!(get("self"), Value::Object(o) if Object::ptr_eq(o, root)));
+        let Value::Object(a) = get("a") else {
+            panic!("missing shared object")
+        };
+        assert!(matches!(get("b"), Value::Object(b) if Object::ptr_eq(a, b)));
+        assert_eq!(
+            read.properties
+                .get(name(mc, "a"), true)
+                .unwrap()
+                .attributes()
+                .bits(),
+            Attribute::DONT_ENUM.bits()
+        );
+        assert_eq!(saved, HeapSnapshot::capture(root).unwrap());
+        let a_read = a.0.borrow();
+        assert!(
+            matches!(a_read.properties.get(name(mc, "nan"), true).unwrap().data(), Value::Number(n) if n.to_bits() == 0x7ff8_0000_0000_0042)
+        );
+        assert!(
+            matches!(a_read.properties.get(name(mc, "negzero"), true).unwrap().data(), Value::Number(n) if n.to_bits() == (-0.0f64).to_bits())
+        );
+    });
+}
+
+#[test]
+fn portable_snapshot_rejects_native_and_virtual_properties() {
+    rootless_mutate(|mc| {
+        let root = Object::new_without_proto(mc);
+        root.set_native(mc, NativeObject::Bool(true));
+        assert!(HeapSnapshot::capture(root).is_err());
+        let root = Object::new_without_proto(mc);
+        let getter = Object::new_without_proto(mc);
+        root.0.borrow_mut(mc).properties.insert(
+            name(mc, "getter"),
+            Property::new_virtual(getter, None, Attribute::empty()),
+            true,
+        );
+        assert!(HeapSnapshot::capture(root).is_err());
+    });
+}
+
+#[test]
+fn portable_snapshot_rejects_watchers_interfaces_and_corrupt_references() {
+    rootless_mutate(|mc| {
+        let root = Object::new_without_proto(mc);
+        root.0.borrow_mut(mc).interfaces = Some(vec![]);
+        assert!(HeapSnapshot::capture(root).is_err());
+        root.0.borrow_mut(mc).interfaces = None;
+        root.0.borrow_mut(mc).watchers.insert(
+            name(mc, "watched"),
+            Watcher::new(root, Value::Null),
+            true,
+        );
+        assert!(HeapSnapshot::capture(root).is_err());
+        root.0.borrow_mut(mc).watchers = PropertyMap::new();
+        root.define_value(mc, name(mc, "self"), root.into(), Attribute::empty());
+        let snapshot = HeapSnapshot::capture(root).unwrap();
+        let mut json = serde_json::to_value(&snapshot).unwrap();
+        json["objects"][0]["properties"][0]["value"]["Object"] = 999.into();
+        let malformed: HeapSnapshot = serde_json::from_value(json).unwrap();
+        assert!(malformed.restore(mc).is_err());
+        let mut json = serde_json::to_value(&snapshot).unwrap();
+        json["version"] = 999.into();
+        let malformed: HeapSnapshot = serde_json::from_value(json).unwrap();
+        assert!(malformed.restore(mc).is_err());
+    });
+}
+
+#[test]
+fn portable_snapshot_rejects_actual_player_root_instead_of_claiming_checkpoint() {
+    crate::avm1::test_utils::with_avm(8, |_, root| {
+        assert!(HeapSnapshot::capture(root).is_err());
+        Ok(())
+    });
+}
+
+// The child entry point is selected by exact name, so neither child re-runs
+// the parent test. Only JSON bytes survive producer process exit.
+#[test]
+fn portable_snapshot_process_child() {
+    let Ok(mode) = std::env::var("RUFFLE_HEAP_SNAPSHOT_CHILD_MODE") else {
+        return;
+    };
+    let path = std::env::var_os("RUFFLE_HEAP_SNAPSHOT_CHILD_PATH").unwrap();
+    if mode == "export" {
+        let bytes = rootless_mutate(|mc| {
+            let root = Object::new_without_proto(mc);
+            let shared = Object::new_without_proto(mc);
+            root.define_value(mc, name(mc, "self"), root.into(), Attribute::empty());
+            root.define_value(mc, name(mc, "a"), shared.into(), Attribute::DONT_ENUM);
+            root.define_value(mc, name(mc, "b"), shared.into(), Attribute::READ_ONLY);
+            serde_json::to_vec(&HeapSnapshot::capture(root).unwrap()).unwrap()
+        });
+        std::fs::write(path, bytes).unwrap();
+    } else {
+        assert_eq!(mode, "restore");
+        let saved: HeapSnapshot = serde_json::from_slice(&std::fs::read(path).unwrap()).unwrap();
+        rootless_mutate(|mc| {
+            let root = saved.restore(mc).unwrap();
+            let data = root.0.borrow();
+            assert!(
+                matches!(data.properties.get(name(mc, "self"), true).unwrap().data(), Value::Object(o) if Object::ptr_eq(o, root))
+            );
+            let Value::Object(a) = data.properties.get(name(mc, "a"), true).unwrap().data() else {
+                panic!("object a")
+            };
+            assert!(
+                matches!(data.properties.get(name(mc, "b"), true).unwrap().data(), Value::Object(b) if Object::ptr_eq(a, b))
+            );
+            assert_eq!(saved, HeapSnapshot::capture(root).unwrap());
+        });
+    }
+}
+
+#[test]
+fn portable_snapshot_survives_producer_exit_and_fresh_process_restore() {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../target")
+        .join(format!("portable_snapshot_{}.json", std::process::id()));
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    let run_child = |mode| {
+        std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "avm1::object::script_object::portable_snapshot_tests::portable_snapshot_process_child", "--nocapture"])
+            .env("RUFFLE_HEAP_SNAPSHOT_CHILD_MODE", mode)
+            .env("RUFFLE_HEAP_SNAPSHOT_CHILD_PATH", &path)
+            .output()
+            .unwrap()
+    };
+    let exported = run_child("export");
+    assert!(exported.status.success(), "export: {:?}", exported);
+    let restored = run_child("restore");
+    std::fs::remove_file(path).unwrap();
+    assert!(restored.status.success(), "restore: {:?}", restored);
+}
diff --git a/core/src/avm_rng.rs b/core/src/avm_rng.rs
