@@ -15,6 +15,19 @@ pub struct AvmRng {
 }
 
 impl AvmRng {
+    /// Capture an initialized generator. Zero defers seeding to the host clock,
+    /// so it cannot promise deterministic continuation without locale state.
+    pub fn snapshot_state(&self) -> Option<std::num::NonZeroU32> {
+        std::num::NonZeroU32::new(self.u_value)
+    }
+
+    /// Recreate an initialized generator without consulting the host clock.
+    pub fn from_snapshot_state(state: std::num::NonZeroU32) -> Self {
+        Self {
+            u_value: state.get(),
+        }
+    }
+
     fn init_with_seed(&mut self, seed: u32) {
         self.u_value = seed;
     }
@@ -64,3 +77,29 @@ impl AvmRng {
 fn get_seed(locale: &dyn LocaleBackend) -> u32 {
     locale.get_current_date_time().timestamp_micros() as u32
 }
+
+#[cfg(test)]
+mod portable_snapshot_tests {
+    use super::*;
+    use crate::backend::locale::DeterministicLocaleBackend;
+
+    #[test]
+    fn portable_snapshot_rng_continues_without_reseeding() {
+        let locale = DeterministicLocaleBackend::default();
+        let mut original = AvmRng::default();
+        assert!(original.snapshot_state().is_none());
+        for _ in 0..17 {
+            original.generate_random_number(&locale);
+        }
+        let state = original.snapshot_state().expect("initialized RNG");
+        let expected: Vec<_> = (0..64)
+            .map(|_| original.generate_random_number(&locale))
+            .collect();
+        drop(original);
+        let mut restored = AvmRng::from_snapshot_state(state);
+        let actual: Vec<_> = (0..64)
+            .map(|_| restored.generate_random_number(&locale))
+            .collect();
+        assert_eq!(expected, actual);
+    }
+}
